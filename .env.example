# rsync.ai — Root environment example
# Copy to .env and fill in your values. NEVER commit .env to git.
#
# Generate secrets:  openssl rand -base64 32

# ─── LLM (required) ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Logo.dev API token for the connector logo downloader (img.logo.dev).
# Leave empty to skip that source; NEVER commit a real token.
LOGO_DEV_TOKEN=

# Azure OpenAI (set LLM_PROVIDER=azure to use)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ─── Security (generate fresh — changing after first run breaks encrypted data) ─
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
# Only the FIRST 32 characters are used (crypto normalizeKeyBytes -> kb[:32]), so
# two keys differing only after char 32 are the same key and "rotating" between
# them is a silent no-op. See docs/internal/new-cloud-secret-model.md.
ENCRYPTION_KEY=change-me-must-be-32-chars-minimum!!
# Shared secret for service-to-service auth (api-gateway → orchestrator). Must be
# non-empty and identical across services, else internal calls 401 in production.
INTERNAL_SERVICE_SECRET=change-me-generate-with-openssl-rand-hex-32

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=rsync
POSTGRES_PASSWORD=change-me-strong-password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong-password

# ─── Object storage (MinIO) ───────────────────────────────────────────────────
# docker-compose.yml defaults both to `minioadmin` for local dev. Production
# (docker-compose.prod.yml) makes them :?-required and refuses that default —
# see .env.prod.example. docker-compose.quickstart.yml reads a DIFFERENT pair,
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY; the two names are not interchangeable.
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin

# ─── Kafka: bring your own / managed broker (optional) ────────────────────────
# Every variable in this section is UNSET by default, and unset means the
# bundled single-node PLAINTEXT broker. Leave the whole block commented unless
# you are pointing the stack at your own cluster.
#
# READ THIS FIRST: compose injects only what a service DECLARES. A value set
# here reaches interpolation, but only the keys in the `x-kafka-security`
# anchor at the top of docker-compose.yml are handed to a container, so a name
# that is not in that anchor is a silent no-op — the operator sets a password,
# the client connects anonymously, and an ACL-enforcing broker rejects it with
# an error naming the BROKER rather than the missing setting.
#
#   Reference : docs/deployment/env-vars.md  § Kafka client security
#   Walkthrough: docs/deployment/self-hosting.md § Bring Your Own Kafka
#   Broker ACLs: docs/deployment/kafka-acls.md
#
# --- Where the cluster is -----------------------------------------------------
# Comma-separated; the CSV is preserved end to end (kafkaclient.ParseBrokers).
# Collapsing a multi-broker cluster to one hostname gives you a single point of
# failure that looks like it works. MSK listener ports: 9092 PLAINTEXT,
# 9094 TLS, 9096 SASL/SCRAM, 9098 IAM — the port must match the protocol below.
# KAFKA_BROKERS=b-1.example-cluster.kafka.example.com:9096,b-2.example-cluster.kafka.example.com:9096

# --- Durability of the topics this platform creates ---------------------------
# RF=1 topics go unavailable during routine rolling maintenance.
# KAFKA_MIN_INSYNC_REPLICAS must be <= KAFKA_REPLICATION_FACTOR. Inverted, the
# topic is created SUCCESSFULLY and then rejects every acks=all write.
# KAFKA_REPLICATION_FACTOR=3
# KAFKA_MIN_INSYNC_REPLICAS=2

# --- How to authenticate ------------------------------------------------------
# PLAINTEXT (default) | SSL | SASL_PLAINTEXT | SASL_SSL.
# Setting a username/password while leaving this unset does NOT authenticate:
# the connection is anonymous and the credentials are discarded with a warning
# (shared/go/kafkaclient/config.go:281-298). This is the single most common
# BYO-Kafka slip.
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 | AWS_MSK_IAM | OAUTHBEARER.
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=rsync-app
# KAFKA_SASL_PASSWORD=replace-me-with-your-broker-password

# --- AWS_MSK_IAM: no static secret, signed from the ambient AWS credential chain
# Requires KAFKA_SECURITY_PROTOCOL=SASL_SSL — the IAM token is a bearer
# credential and the client REFUSES to send it unencrypted (config.go:461-464).
# GO SERVICES ONLY. The Python tier raises KafkaSecurityError
# (llm-service/src/utils/kafka_security.py:123) and the JVM Kafka Connect image
# ships no IAM login module, so an IAM-only cluster runs the Go data plane and
# leaves the CDC profile unable to authenticate. Use SCRAM for a mixed stack.
# Falls back to AWS_REGION, then AWS_DEFAULT_REGION.
# KAFKA_AWS_REGION=us-east-1

# --- OAUTHBEARER: OIDC client-credentials -------------------------------------
# CLIENT_ID / CLIENT_SECRET fall back to KAFKA_SASL_USERNAME / _PASSWORD.
# KAFKA_SASL_OAUTHBEARER_TOKEN_ENDPOINT=https://issuer.example.com/oauth2/token
# KAFKA_SASL_OAUTHBEARER_CLIENT_ID=rsync-kafka-client
# KAFKA_SASL_OAUTHBEARER_CLIENT_SECRET=replace-me-with-your-oidc-client-secret
# KAFKA_SASL_OAUTHBEARER_SCOPE=kafka
# KAFKA_SASL_OAUTHBEARER_EXTENSIONS=logicalCluster=lkc-00000,identityPoolId=pool-00000
# JVM-only (Kafka Connect / Debezium schema history). Leave empty for the
# default; override ONLY to match your broker's Kafka version.
# KAFKA_SASL_OAUTHBEARER_LOGIN_CALLBACK_HANDLER=

# --- TLS material: these are paths INSIDE the container -----------------------
# Nothing mounts them for you. Add a read-only bind to every service that talks
# to Kafka; the overlay is in self-hosting.md § Bring Your Own Kafka.
# KAFKA_SSL_CA_LOCATION=/etc/rsync/kafka/ca.pem
# mTLS, as two paths. Both or neither — half a pair fails closed rather than
# silently downgrading to server-only TLS (config.go:445-448).
# KAFKA_SSL_CERT_LOCATION=/etc/rsync/kafka/client.crt
# KAFKA_SSL_KEY_LOCATION=/etc/rsync/kafka/client.key
# The SAME keypair as ONE file (chain + key) — the only shape a JVM can load,
# so it is not derivable from the pair above:  cat client.crt client.key > client.pem
# Inert in the Go and Python services; kafka-init and kafka-connect need it.
# KAFKA_SSL_KEYSTORE_LOCATION=/etc/rsync/kafka/client.pem

# --- Turning certificate verification OFF: a self-signed lab, never production
# TWO SPELLINGS FOR ONE SETTING. Python reads only KAFKA_SSL_SKIP_VERIFY
# (kafka_security.py:54); Go reads both (config.go:80, alias at :115). Compose
# defaults each to the other so setting EITHER reaches every service. Set as a
# pair if you edit them by hand.
# KAFKA_SSL_SKIP_VERIFY=false
# KAFKA_SSL_INSECURE_SKIP_VERIFY=false

# ─── Admin ────────────────────────────────────────────────────────────────────
RSYNC_ADMIN_EMAILS=you@example.com

# ─── Domain (production) ──────────────────────────────────────────────────────
DOMAIN=your-domain.com
ACME_EMAIL=you@example.com
# PUBLIC_HOST is used by docker-compose.traefik.yml (Traefik routing)
PUBLIC_HOST=your-domain.com
PUBLIC_URL=https://your-domain.com
PUBLIC_WS_URL=wss://your-domain.com/ws
NEXTAUTH_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
OAUTH_CALLBACK_URL=https://your-domain.com/api/v1/auth/oauth/callback

# ─── OAuth (optional — leave blank to use email/password login only) ──────────
# Each provider only activates when BOTH _CLIENT_ID and _CLIENT_SECRET are set.
# Callback URL to register in each app: ${OAUTH_CALLBACK_URL} (set above)
#
# GitHub OAuth App  → https://github.com/settings/developers → "New OAuth App"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth App  → https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Slack App         → https://api.slack.com/apps → "Create New App" → OAuth & Permissions
# Required scopes: channels:read channels:history users:read chat:write
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# HubSpot App       → https://developers.hubspot.com → "Create App" → Auth tab
# Required scopes: crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Salesforce App    → Setup → App Manager → "New Connected App"
# Required scopes: api refresh_token offline_access
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Pipedrive App     → https://developers.pipedrive.com → "Create an app"
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# ─── Notifier (pipeline failure delivery) ─────────────────────────────────────
# api-gateway runs a notifier consumer that delivers pipeline alerts to Slack +
# email. Leave these empty in dev to keep notifications in "persist-only" mode
# (queryable via UI, no external send).
NOTIFIER_SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Optional integrations ────────────────────────────────────────────────────
CONTEXT7_API_KEY=
ANTHROPIC_API_KEY=
