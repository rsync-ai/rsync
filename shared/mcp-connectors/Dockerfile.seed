# Connector-seed image (OSS / community).
#
# Populates the `mcp_connectors` named volume so a COLD self-host boots WITH connectors
# instead of an empty volume (the "zero connectors = dead-on-arrival" P0). A one-shot init
# container runs seed-connectors.sh on every boot: it seeds an empty volume, refreshes the
# shipped connectors after an upgrade, keeps generated connectors, and hands the tree to
# tool-generator's uid. Its header says exactly what it replaces and keeps.
#
# ALLOWLIST COPY — bakes ONLY runtime connector artifacts (all verified YAML-free):
#   public/         pre-built public connectors + their versions/<v>/ snapshots
#   internal/       debezium, kafka-mcp-sink, minio (+ context7) internal connectors
#   schemas/        connector spec schemas used at build time
#   base_connector.py   shared base class (also the BuildKit `shared` context for JIT builds)
#
# INTENTIONALLY NOT baked (moat / generation-only):
#   generators/     connector-generation tooling (method_injector.py)
#   oauth/          curated OAuth registry (providers.json + oauth_registry.py) — cloud-only.
#                   base_connector.py's `from oauth.token_manager import TokenManager` is a
#                   lazy, optional import (only OAuth connectors hit it), so module load is fine.
#   tests/, *.md    not needed at runtime
FROM busybox:1.38

WORKDIR /seed
COPY public/ ./public/
COPY internal/ ./internal/
COPY schemas/ ./schemas/
COPY base_connector.py ./base_connector.py

# Outside /seed so the script itself is not copied into the volume. Compose runs this CMD
# as is -- an inline `command:` there once skipped any populated volume, which is how an
# upgrade kept the previous release's connector code.
COPY seed-connectors.sh /usr/local/bin/seed-connectors.sh
CMD ["sh", "/usr/local/bin/seed-connectors.sh"]
