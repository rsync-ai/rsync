{
  "id": "clickhouse",
  "name": "ClickHouse",
  "display_name": "ClickHouse",
  "aliases": [
    "clickhouse",
    "clickhouse-server",
    "yandex-clickhouse"
  ],
  "version": "1.0.0",
  "description": "Connector for ClickHouse (OLAP columnar warehouse) as a batch source and destination. Uses the official clickhouse-connect HTTP driver (port 8123). Optimized reads (offset/keyset pagination) and optimized writes (INSERT ... FORMAT JSONEachRow with best-effort type coercion; ensure_table creates ReplacingMergeTree/MergeTree with an explicit sort key; keyed upsert converges via OPTIMIZE ... FINAL).",
  "connector_type": "clickhouse",
  "category": "relational_db",
  "supported_versions": {
    "batch": "ClickHouse 21.8+ (HTTP interface). Verified against ClickHouse 25.5."
  },
  "runtime": "python",
  "entrypoint": "connector.py",
  "supports_source": true,
  "supports_destination": true,
  "supports_cdc": false,
  "spec_version": "1.0",
  "status": "active",
  "quality_tier": "bronze",
  "auth_type": "basic",
  "supported_auth_methods": [
    {
      "method": "basic",
      "header_name": "",
      "header_prefix": "",
      "config_keys": [
        "user",
        "password"
      ],
      "description": "Username/password authentication to the ClickHouse HTTP interface (port 8123; set secure=true for HTTPS on 8443)."
    }
  ],
  "required_config": [
    "host",
    "database",
    "user"
  ],
  "optional_config": [
    "port",
    "password",
    "secure"
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "host": {"type": "string", "description": "ClickHouse host (e.g. my-clickhouse.example.com or a ClickHouse Cloud endpoint)"},
      "port": {"type": "integer", "description": "HTTP interface port (8123 plain / 8443 secure)", "default": 8123},
      "database": {"type": "string", "description": "Database name (ClickHouse single namespace)", "default": "default"},
      "user": {"type": "string", "description": "ClickHouse user", "default": "default"},
      "password": {"type": "string", "description": "ClickHouse password", "secret": true},
      "secure": {"type": "boolean", "description": "Use HTTPS (TLS) for the HTTP interface", "default": false}
    },
    "required": ["host", "database", "user"]
  },
  "configuration_schema": {
    "type": "object",
    "properties": {
      "host": {"type": "string", "description": "ClickHouse host (e.g. my-clickhouse.example.com or a ClickHouse Cloud endpoint)"},
      "port": {"type": "integer", "description": "HTTP interface port (8123 plain / 8443 secure)", "default": 8123},
      "database": {"type": "string", "description": "Database name (ClickHouse single namespace)", "default": "default"},
      "user": {"type": "string", "description": "ClickHouse user", "default": "default"},
      "password": {"type": "string", "description": "ClickHouse password", "secret": true},
      "secure": {"type": "boolean", "description": "Use HTTPS (TLS) for the HTTP interface", "default": false}
    },
    "required": ["host", "database", "user"]
  },
  "capabilities": {
    "max_batch_size": 100000,
    "supported_formats": ["csv", "json", "jsonl"],
    "supported_compressions": ["none", "gzip"],
    "supports_cdc": false,
    "supports_ddl": true,
    "auto_create_destination_tables": true,
    "load_strategy": {
      "load_method": "insert",
      "merge_method": "replacing_merge_tree",
      "supports_staging": false,
      "max_batch_rows": 100000,
      "notes": "Writes are INSERT ... FORMAT JSONEachRow (date_time_input_format=best_effort so string timestamps/decimals coerce server-side). ensure_table creates ReplacingMergeTree ORDER BY (keys) when key fields are known, else MergeTree ORDER BY tuple(); non-key columns are Nullable. Keyed upsert INSERTs then OPTIMIZE ... FINAL to converge duplicates on the sort key (ClickHouse has no atomic UPSERT)."
    }
  },
  "operations": [
    {"name": "test_connection", "type": "core", "description": "Test connectivity to the ClickHouse server", "method": "clickhouse_test_connection"},
    {"name": "validate_config", "type": "core", "description": "Validate configuration without connecting", "method": "clickhouse_validate_config"},
    {"name": "discover_schema", "type": "core", "description": "Discover tables/columns in the configured database (system.tables/system.columns)", "method": "clickhouse_discover_schema"},
    {"name": "get_capabilities", "type": "core", "description": "Return connector capabilities", "method": "clickhouse_get_capabilities"},
    {"name": "export", "type": "source", "description": "Paginated read from a table (offset/keyset)", "method": "clickhouse_export", "parameters": [
      {"name": "table", "type": "string", "required": true},
      {"name": "cursor_column", "type": "string", "required": false, "description": "Unique column for keyset pagination"},
      {"name": "cursor_value", "type": "string", "required": false, "description": "Resume boundary echoed back as next_cursor"},
      {"name": "limit", "type": "integer", "required": false, "default": 10000},
      {"name": "offset", "type": "integer", "required": false, "default": 0}
    ]},
    {"name": "ensure_table", "type": "destination", "description": "Create / migrate the destination table from canonical column types (MergeTree/ReplacingMergeTree)", "method": "clickhouse_ensure_table", "parameters": [
      {"name": "table", "type": "string", "required": true},
      {"name": "columns", "type": "array", "required": true},
      {"name": "column_types", "type": "object", "required": false},
      {"name": "key_fields", "type": "array", "required": false}
    ]},
    {"name": "import_data", "type": "destination", "description": "Append rows (INSERT ... FORMAT JSONEachRow)", "method": "clickhouse_import_data", "parameters": [
      {"name": "table", "type": "string", "required": true},
      {"name": "data", "type": "array", "required": true}
    ]},
    {"name": "upsert_data", "type": "destination", "description": "Upsert rows (INSERT + OPTIMIZE ... FINAL on the sort key)", "method": "clickhouse_upsert_data", "parameters": [
      {"name": "table", "type": "string", "required": true},
      {"name": "data", "type": "array", "required": true},
      {"name": "key_fields", "type": "array", "required": false}
    ]},
    {"name": "drop_table", "type": "destination", "description": "Drop the destination table (reload mode)", "method": "clickhouse_drop_table", "parameters": [
      {"name": "table", "type": "string", "required": true}
    ]}
  ],
  "license": "MIT",
  "source": "built_in"
}
