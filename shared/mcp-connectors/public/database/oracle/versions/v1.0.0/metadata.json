  "connector_type": "oracle",
  "category": "relational_db",
  "supported_versions": {
    "batch": "Oracle Database 12c and later (uses OFFSET/FETCH row-limiting). Autonomous Database and RDS for Oracle supported for batch via service_name / wallet.",
    "cdc": "Oracle 12c+ via Debezium LogMiner (io.debezium.connector.oracle.OracleConnector). Requires ARCHIVELOG mode, database- and table-level supplemental logging, and a LogMiner capture user — provisioned/validated by the orchestrator's Oracle CDC provider (DBA-only prerequisites are escalated). XStream (GoldenGate license) not used."
  },
