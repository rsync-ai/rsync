  "configuration_schema": {
    "type": "object",
    "properties": {
      "host": {
        "type": "string",
        "description": "Oracle host address (e.g. db.example.com or an Autonomous DB host)"
      },
      "port": {
        "type": "integer",
        "description": "Oracle listener port number (default 1521)"
      },
      "service_name": {
        "type": "string",
        "description": "Oracle service name (modern; Easy-Connect). Prefer over SID. If omitted, 'database' is treated as the service name."
      },
      "sid": {
        "type": "string",
        "description": "Oracle SID (legacy). Used only when no service_name/dsn is given."
      },
      "database": {
        "type": "string",
        "description": "Service name alias (accepted as the service_name for compatibility with the generic DB config shape)."
      },
      "dsn": {
        "type": "string",
        "description": "Full DSN / Easy-Connect string (host:port/service) or a tnsnames alias. Takes precedence over host/port/service_name."
      },
      "user": {
        "type": "string",
        "description": "Oracle username. For multitenant CDC, a common user (c##dbzuser) is created by the DBA."
      },
      "password": {
        "type": "string",
        "description": "Oracle password",
        "secret": true
      },
      "wallet_location": {
        "type": "string",
        "description": "Path to an Oracle wallet directory (Autonomous DB mTLS). Sets config_dir + wallet_location for python-oracledb thin mode."
      },
      "wallet_password": {
        "type": "string",
        "description": "Wallet password (if the wallet is password-protected)",
        "secret": true
      }
    },
    "required": [
      "host",
      "port",
      "user",
      "password"
    ]
  },
