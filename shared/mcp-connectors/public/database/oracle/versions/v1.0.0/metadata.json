    },
    {
      "name": "validate_config",
      "type": "core",
      "description": "Validate configuration without connecting",
      "method": "oracle_validate_config"
    },
    {
      "name": "discover_schema",
      "type": "core",
      "description": "Discover available tables and their schemas",
      "method": "oracle_discover_schema",
      "parameters": [
        {
          "name": "include_columns",
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "Include column metadata (names, types, nullability)"
        },
        {
          "name": "include_row_counts",
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "Include estimated row counts (fast, no full scans)"
        },
        {
          "name": "include_relationships",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Include primary keys and foreign keys (for agents)"
        },
        {
          "name": "include_indexes",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Include index metadata (for agents)"
        },
        {
          "name": "max_tables",
          "type": "integer",
          "required": false,
          "default": 100,
          "description": "Maximum number of tables to return"
        }
      ]
    },
    {
      "name": "get_capabilities",
      "type": "core",
      "description": "Return connector capabilities for agent interaction",
      "method": "oracle_get_capabilities"
    },
    {
      "name": "export",
      "type": "source",
      "description": "Export data from a table",
      "method": "oracle_export",
      "parameters": [
        {
          "name": "table",
          "type": "string",
          "required": true
        },
        {
          "name": "limit",
          "type": "integer",
          "required": false,
          "default": 10000
        },
        {
