          "type": "integer",
          "required": false,
          "default": 0
        },
        {
          "name": "where",
          "type": "string",
          "required": false,
          "default": ""
        },
        {
          "name": "columns",
          "type": "array",
          "required": false,
          "default": []
        }
      ]
    },
