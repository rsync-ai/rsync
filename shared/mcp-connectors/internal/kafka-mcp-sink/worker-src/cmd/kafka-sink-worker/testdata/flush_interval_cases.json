{
  "_about": "Shared contract for destination_config.max_file_interval_seconds. The worker (objectFlushIntervalOverride in main.go, cdc_flush_interval_test.go) and the kafka-mcp-sink connector (flush_interval_error in versions/v1.0.0/connector.py, shared/mcp-connectors/tests/test_kafka_sink_flush_interval.py) both run every case, so the connector never lets through a value the worker refuses, or refuses one the worker accepts. expect is the interval in seconds, \"unset\" (keep the 30-second default) or \"refused\".",
  "min_seconds": 1,
  "max_seconds": 240,
  "cases": [
    {"name": "number", "value": 120, "expect": 120},
    {"name": "number at the lower bound", "value": 1, "expect": 1},
    {"name": "number at the upper bound", "value": 240, "expect": 240},
    {"name": "whole float at the upper bound", "value": 240.0, "expect": 240},
    {"name": "number zero", "value": 0, "expect": "refused"},
    {"name": "number just above the upper bound", "value": 241, "expect": "refused"},
    {"name": "negative number", "value": -5, "expect": "refused"},
    {"name": "absurd number", "value": 1e12, "expect": "refused"},
    {"name": "fraction", "value": 30.5, "expect": "refused"},
    {"name": "fraction just above the upper bound", "value": 240.5, "expect": "refused"},
    {"name": "fraction just below the lower bound", "value": 0.9999, "expect": "refused"},
    {"name": "string", "value": "45", "expect": 45},
    {"name": "string with spaces", "value": " 60 ", "expect": 60},
    {"name": "string with a plus sign", "value": "+30", "expect": 30},
    {"name": "string at the upper bound", "value": "240", "expect": 240},
    {"name": "leading zero is decimal, not octal", "value": "030", "expect": 30},
    {"name": "hex string", "value": "0x1E", "expect": "refused"},
    {"name": "binary string", "value": "0b11110", "expect": "refused"},
    {"name": "underscore digits", "value": "1_0", "expect": "refused"},
    {"name": "underscore digits out of range", "value": "1_000", "expect": "refused"},
    {"name": "string zero", "value": "0", "expect": "refused"},
    {"name": "negative zero", "value": "-0", "expect": "refused"},
    {"name": "string just above the upper bound", "value": "241", "expect": "refused"},
    {"name": "negative string", "value": "-5", "expect": "refused"},
    {"name": "fraction string", "value": "30.5", "expect": "refused"},
    {"name": "whole fraction string", "value": "30.0", "expect": "refused"},
    {"name": "not a number", "value": "abc", "expect": "refused"},
    {"name": "lone plus", "value": "+", "expect": "refused"},
    {"name": "lone minus", "value": "-", "expect": "refused"},
    {"name": "non-ASCII digits", "value": "٣٠", "expect": "refused"},
    {"name": "fullwidth digits", "value": "１２０", "expect": "refused"},
    {"name": "json null", "value": null, "expect": "unset"},
    {"name": "empty string", "value": "", "expect": "unset"},
    {"name": "whitespace only", "value": "   ", "expect": "unset"},
    {"name": "orchestrator's flattened null", "value": "<nil>", "expect": "unset"},
    {"name": "null string", "value": "null", "expect": "unset"},
    {"name": "upper-case null string", "value": "NULL", "expect": "unset"},
    {"name": "padded null string", "value": " null ", "expect": "unset"},
    {"name": "true", "value": true, "expect": "refused"},
    {"name": "false", "value": false, "expect": "refused"},
    {"name": "list", "value": [30], "expect": "refused"},
    {"name": "object", "value": {"seconds": 30}, "expect": "refused"}
  ]
}
