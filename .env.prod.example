# =============================================================================
# rsync-ai — Production Environment Variables
# =============================================================================
# Copy this file to .env.prod and fill in all required values.
#
# Usage:
#   cp .env.prod.example .env.prod
#   # Edit .env.prod with your values
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
# =============================================================================

# -----------------------------------------------------------------------------
# DOMAIN & TLS
# -----------------------------------------------------------------------------
# Your fully-qualified domain name (e.g., rsync.example.com)
DOMAIN=rsync.example.com

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=admin@example.com

# Cloudflare API token for DNS-01 challenge (required when Cloudflare proxy is enabled)
# Create at: Cloudflare → My Profile → API Tokens → Create Token → Edit zone DNS
CF_DNS_API_TOKEN=

# Optional: override public-facing URLs (defaults derive from DOMAIN)
# IMPORTANT:
# - NEXT_PUBLIC_API_URL should be the *origin* (no /api). The app appends `/api/v1/...`.
# - OAUTH_CALLBACK_URL must match the api-gateway route: `/oauth/callback/:provider` (no /api).
#
# NEXT_PUBLIC_API_URL=https://rsync.example.com
# NEXT_PUBLIC_WS_URL=wss://rsync.example.com/ws
# NEXTAUTH_URL=https://rsync.example.com
# OAUTH_CALLBACK_URL=https://rsync.example.com/oauth/callback

# -----------------------------------------------------------------------------
# SECRETS (REQUIRED — stack will not start in production without these)
# -----------------------------------------------------------------------------
# Default values are provided for quick first-run setup.
# IMPORTANT: Change ALL of these before exposing the service to the internet.
# Generate strong replacements with: openssl rand -base64 32

# 32+ character key for encrypting stored connection credentials.
# WARNING: Changing this after first run makes existing connections unreadable!
# WARNING: ONLY THE FIRST 32 CHARACTERS ARE USED (shared/go/crypto/encryption.go
#   normalizeKeyBytes returns kb[:32]). `openssl rand -base64 32` emits 44 chars;
#   the last 12 are decorative. Two keys that differ only after char 32 ARE THE
#   SAME KEY — a "rotation" to one is a silent no-op with no error. A key shorter
#   than 32 chars is dropped from the keyring with a log line, not a crash.
# MIGRATING TO A NEW HOST? Carry this value over with the data, then rotate
#   deliberately: ENCRYPTION_KEYS=<new>,<old> → restore → POST
#   /api/v1/admin/encryption/rotate → verify → drop <old>. Ciphertext is
#   key-tagged, so both keys coexist safely during the rotation. Restoring the
#   database WITHOUT the old key in ENCRYPTION_KEYS is unrecoverable.
#   Full procedure: docs/internal/new-cloud-secret-model.md
# TODO: Replace with your own secret → openssl rand -base64 32
ENCRYPTION_KEY=rsync-default-encryption-key-change-me!!

# JWT signing secret for API authentication.
# TODO: Replace with your own secret → openssl rand -base64 32
JWT_SECRET=rsync-default-jwt-secret-change-me-in-prod!

# Shared secret authenticating service-to-service calls (api-gateway → orchestrator:
# connection tests, OAuth refresh). MUST be non-empty and identical across
# api-gateway, orchestrator, and frontend. If empty, the orchestrator runs
# ENVIRONMENT=production and fails requirePrincipal closed → internal calls 401.
# TODO: Replace with your own secret → openssl rand -hex 32
INTERNAL_SERVICE_SECRET=rsync-default-internal-service-secret-change-me!

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Option A: External managed database (RECOMMENDED for production)
# Use this when running on Azure Database for PostgreSQL, AWS RDS, etc.
# Set DATABASE_URL and leave POSTGRES_* vars — they are only used by the
# bundled postgres container (which is skipped when DATABASE_URL is set).
#
# Azure PostgreSQL Flexible Server example:
#   DATABASE_URL=postgresql://<admin-user>:<password>@<server>.postgres.database.azure.com:5432/pipeline_db?sslmode=require
#
# TODO: Replace with your managed DB connection string
# Option A: Managed PostgreSQL (Azure / RDS / Supabase / Neon)
# Set DATABASE_URL and POSTGRES_HOST to your managed DB.
# Local postgres container is disabled when POSTGRES_HOST != "postgres".
DATABASE_URL=
# e.g. my-db-server.postgres.database.azure.com, my-db.abc123.us-east-1.rds.amazonaws.com
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rsync
POSTGRES_DB=pipeline_db
# TLS to the metadata database. These two are ONE fact and must agree.
#
# DB_SSLMODE covers the Go services: api-gateway's DSN, the orchestrator
# (DB_SSLMODE), the temporal-adapter (POSTGRES_SSLMODE) and the Kafka sink.
# Temporal reads NONE of them — it has its own switch, and it is really two
# programs (schema tool, then server) that this key feeds together.
#
# Set them together or not at all. On a managed instance (Azure / RDS / Cloud
# SQL / Neon) that is:
#   DB_SSLMODE=require
#   POSTGRES_TLS_ENABLED=true
#
# Half-on is the failure this pairing exists to prevent, and it is quiet in both
# directions. sslmode alone: Temporal's schema step is rejected before the
# server binds, so there is no TLS error anywhere — just no workflow engine and
# every pipeline hanging. TLS switch alone: libpq negotiates PLAINTEXT rather
# than erroring, so the database password crosses the network in the clear while
# the deploy looks healthy.
#
# Shipped ON, because this is the PROD template and every managed instance
# requires TLS. scripts/preflight-prod-config.sh enforces this exact pair, so
# the template as shipped is the configuration the gate blesses — an operator
# who changes nothing gets the correct posture and a clean preflight.
#
# The earlier `disable`/`false` pair was worse than it looked: the documented
# launch is `--env-file .env.prod` (docker-compose.prod.yml:5), so the template
# overrode the compose defaults and re-created the plaintext posture the
# defaults had just been fixed to prevent.
#
# Pointing prod at a plaintext local Postgres instead? Flip BOTH together and
# expect preflight to refuse the deploy — that is the gate working, not a bug.
DB_SSLMODE=require
POSTGRES_TLS_ENABLED=true

# TODO: Change to a strong password before going live
POSTGRES_PASSWORD=rsync_default_password_change_me

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# TODO: Change to a strong password before going live
REDIS_PASSWORD=rsync_redis_default_change_me

# -----------------------------------------------------------------------------
# OBJECT STORAGE (MinIO) — REQUIRED, the stack will not start without these
# -----------------------------------------------------------------------------
# docker-compose.prod.yml uses ${MINIO_ACCESS_KEY_ID:?...} /
# ${MINIO_SECRET_ACCESS_KEY:?...} for the MinIO server, deliberately refusing the
# minioadmin/minioadmin default. Because one :? aborts interpolation for the whole
# merged config, leaving either unset means NOTHING starts — not just MinIO:
#   error while interpolating services.minio.environment.MINIO_ROOT_USER:
#   required variable MINIO_ACCESS_KEY_ID is missing a value
# The same two variables also configure every client (api-gateway, orchestrator,
# temporal-adapter, the bucket-init job), so one value each is all you set.
# NAMING TRAP: docker-compose.quickstart.yml reads a DIFFERENT pair —
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY. Setting the quickstart names here (or these
# names there) fails closed with a "is required" error rather than falling back,
# but they are not interchangeable.
# TODO: Replace both → openssl rand -hex 16 / openssl rand -hex 32
MINIO_ACCESS_KEY_ID=rsync-default-minio-access-key-change-me
MINIO_SECRET_ACCESS_KEY=rsync-default-minio-secret-key-change-me

# -----------------------------------------------------------------------------
# KAFKA — BRING YOUR OWN / MANAGED BROKER (optional)
# -----------------------------------------------------------------------------
# Every variable in this section is UNSET by default, and unset means the
# bundled single-node PLAINTEXT broker. Leave the whole block commented unless
# you are pointing the stack at your own cluster.
#
# READ THIS FIRST: compose injects only what a service DECLARES. A value set
# here reaches interpolation, but only the keys in the `x-kafka-security`
# anchor at the top of docker-compose.yml are handed to a container, so a name
# that is not in that anchor is a silent no-op — the operator sets a password,
# the client connects anonymously, and an ACL-enforcing broker rejects it with
# an error naming the BROKER rather than the missing setting.
#
#   Reference : docs/deployment/env-vars.md  § Kafka client security
#   Walkthrough: docs/deployment/self-hosting.md § Bring Your Own Kafka
#   Broker ACLs: docs/deployment/kafka-acls.md
#
# --- Where the cluster is -----------------------------------------------------
# Comma-separated; the CSV is preserved end to end (kafkaclient.ParseBrokers).
# Collapsing a multi-broker cluster to one hostname gives you a single point of
# failure that looks like it works. MSK listener ports: 9092 PLAINTEXT,
# 9094 TLS, 9096 SASL/SCRAM, 9098 IAM — the port must match the protocol below.
# KAFKA_BROKERS=b-1.example-cluster.kafka.example.com:9096,b-2.example-cluster.kafka.example.com:9096

# --- Durability of the topics this platform creates ---------------------------
# RF=1 topics go unavailable during routine rolling maintenance.
# KAFKA_MIN_INSYNC_REPLICAS must be <= KAFKA_REPLICATION_FACTOR. Inverted, the
# topic is created SUCCESSFULLY and then rejects every acks=all write.
# KAFKA_REPLICATION_FACTOR=3
# KAFKA_MIN_INSYNC_REPLICAS=2

# --- How to authenticate ------------------------------------------------------
# PLAINTEXT (default) | SSL | SASL_PLAINTEXT | SASL_SSL.
# Setting a username/password while leaving this unset does NOT authenticate:
# the connection is anonymous and the credentials are discarded with a warning
# (shared/go/kafkaclient/config.go:281-298). This is the single most common
# BYO-Kafka slip.
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 | AWS_MSK_IAM | OAUTHBEARER.
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=rsync-app
# KAFKA_SASL_PASSWORD=replace-me-with-your-broker-password

# --- AWS_MSK_IAM: no static secret, signed from the ambient AWS credential chain
# Requires KAFKA_SECURITY_PROTOCOL=SASL_SSL — the IAM token is a bearer
# credential and the client REFUSES to send it unencrypted (config.go:461-464).
# GO SERVICES ONLY. The Python tier raises KafkaSecurityError
# (llm-service/src/utils/kafka_security.py:123) and the JVM Kafka Connect image
# ships no IAM login module, so an IAM-only cluster runs the Go data plane and
# leaves the CDC profile unable to authenticate. Use SCRAM for a mixed stack.
# Falls back to AWS_REGION, then AWS_DEFAULT_REGION.
# KAFKA_AWS_REGION=us-east-1

# --- OAUTHBEARER: OIDC client-credentials -------------------------------------
# CLIENT_ID / CLIENT_SECRET fall back to KAFKA_SASL_USERNAME / _PASSWORD.
# KAFKA_SASL_OAUTHBEARER_TOKEN_ENDPOINT=https://issuer.example.com/oauth2/token
# KAFKA_SASL_OAUTHBEARER_CLIENT_ID=rsync-kafka-client
# KAFKA_SASL_OAUTHBEARER_CLIENT_SECRET=replace-me-with-your-oidc-client-secret
# KAFKA_SASL_OAUTHBEARER_SCOPE=kafka
# KAFKA_SASL_OAUTHBEARER_EXTENSIONS=logicalCluster=lkc-00000,identityPoolId=pool-00000
# JVM-only (Kafka Connect / Debezium schema history). Leave empty for the
# default; override ONLY to match your broker's Kafka version.
# KAFKA_SASL_OAUTHBEARER_LOGIN_CALLBACK_HANDLER=

# --- TLS material: these are paths INSIDE the container -----------------------
# Nothing mounts them for you. Add a read-only bind to every service that talks
# to Kafka; the overlay is in self-hosting.md § Bring Your Own Kafka.
# KAFKA_SSL_CA_LOCATION=/etc/rsync/kafka/ca.pem
# mTLS, as two paths. Both or neither — half a pair fails closed rather than
# silently downgrading to server-only TLS (config.go:445-448).
# KAFKA_SSL_CERT_LOCATION=/etc/rsync/kafka/client.crt
# KAFKA_SSL_KEY_LOCATION=/etc/rsync/kafka/client.key
# The SAME keypair as ONE file (chain + key) — the only shape a JVM can load,
# so it is not derivable from the pair above:  cat client.crt client.key > client.pem
# Inert in the Go and Python services; kafka-init and kafka-connect need it.
# KAFKA_SSL_KEYSTORE_LOCATION=/etc/rsync/kafka/client.pem

# --- Turning certificate verification OFF: a self-signed lab, never production
# TWO SPELLINGS FOR ONE SETTING. Python reads only KAFKA_SSL_SKIP_VERIFY
# (kafka_security.py:54); Go reads both (config.go:80, alias at :115). Compose
# defaults each to the other so setting EITHER reaches every service. Set as a
# pair if you edit them by hand.
# KAFKA_SSL_SKIP_VERIFY=false
# KAFKA_SSL_INSECURE_SKIP_VERIFY=false

# -----------------------------------------------------------------------------
# LLM PROVIDER
# -----------------------------------------------------------------------------
# Routing is controlled by LLM_PROVIDER (openai | groq | ollama). The same
# code path handles all three; switching is a config change, not a deploy.
# Cost is tracked per-user via the llm_usage_events table; per-user spend cap
# is enforced via users.cost_quota_usd_cents (default $50/month).
#
# Option A: Azure OpenAI (RECOMMENDED for production — data stays in your Azure tenant)
#   1. Provision an Azure OpenAI resource and create a deployment (e.g. gpt-4o-mini).
#   2. Set the vars below — uses AzureOpenAI SDK client with mandatory api-version parameter.
#   3. Microsoft Founders Hub credits ($25K, no equity) cover ~138 years of gpt-4o-mini at typical load.
#
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<azure-openai-api-key>
# AZURE_OPENAI_API_VERSION=2025-01-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-4o        # must match your Azure deployment name exactly
# LLM_MODEL=                            # leave blank when using Azure — deployment name takes precedence
#
# Note: OPENAI_BASE_URL is kept for backward compatibility with the openai provider only.
# OPENAI_BASE_URL= (deprecated for Azure — use AZURE_OPENAI_ENDPOINT + LLM_PROVIDER=azure instead)
#
# Option B: Public OpenAI API (simplest)
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#   # OPENAI_BASE_URL left unset → defaults to https://api.openai.com
#
# Option C: Groq (free tier 100K tok/day, llama-3.3-70b ≈ gpt-4o quality)
#   LLM_PROVIDER=groq
#   GROQ_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile
#
# Option D: Self-hosted Ollama (air-gapped / on-prem)
#   LLM_PROVIDER=ollama
#   OLLAMA_URL=http://host.docker.internal:11434
#   LLM_MODEL=qwen2.5:7b      # or llama3.1:70b on a GPU host
#
OPENAI_API_KEY=
OPENAI_BASE_URL=
GROQ_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OLLAMA_URL=http://host.docker.internal:11434

# -----------------------------------------------------------------------------
# DATA EXPLORER LLM
# -----------------------------------------------------------------------------
# By default the Explorer inherits LLM_PROVIDER above (Azure OpenAI in production).
# Only table/column names and data types are sent — never actual row data.
#
# To force Ollama for air-gapped/on-prem deployments (schema stays 100% local):
#   EXPLORER_OFFLINE_ONLY=true
#
# Defaults when EXPLORER_OFFLINE_ONLY=false (production):
#   EXPLORER_LLM_PROVIDER → inherits LLM_PROVIDER (openai)
#   EXPLORER_TABLE_LINK_MODEL → gpt-4o-mini
#   EXPLORER_SQL_ALLOW_ONLINE → true
#
# Override individual models if needed (uncomment to customise):
# EXPLORER_TABLE_LINK_MODEL=gpt-4o-mini
# EXPLORER_COLUMN_LINK_MODEL=gpt-4o-mini
# EXPLORER_NEXT_STEPS_MODEL=gpt-4o-mini
# EXPLORER_QUERY_SPEC_MODEL=gpt-4o-mini
# EXPLORER_SQL_MODEL=gpt-4o-mini
EXPLORER_OFFLINE_ONLY=false

# -----------------------------------------------------------------------------
# EMAIL VERIFICATION (Resend API)
# -----------------------------------------------------------------------------
# IMPORTANT — how the gate actually behaves (api-gateway/internal/handlers/auth.go):
#   resendConfigured := emailClient.IsConfigured()      // needs a REAL key AND a sender
#   if !resendConfigured || userCount == 0 { emailVerified = true }   // AUTO-VERIFY
#
# => If RESEND_API_KEY is unset, left as the placeholder below, or RESEND_FROM_ADDR is
#    unset, EVERY signup is auto-verified and the user can log in immediately with NO
#    email confirmation. Half-configuring is deliberately NOT a middle state: without
#    a sender on a domain your own Resend account has verified, every send would be
#    rejected and the accounts it gated would be locked out with no way in.
#    (The very first user — userCount==0, the bootstrap admin — is always
#    auto-verified by design so they can log in to configure the instance.)
#
# This is intentional for self-hosted / air-gapped installs, but for public SaaS
# you MUST set a real key or signups skip email verification.
#
# ----- RESEND SETUP CHECKLIST (required to ENFORCE email verification on prod) -----
#   [ ] 1. Sign up at https://resend.com (free tier: 100 emails/day, 3,000/month)
#   [ ] 2. Add your domain (e.g. your-company.com) in Resend → Domains, and add the
#          DKIM/SPF/DMARC DNS records it gives you. Wait for "Verified" status.
#   [ ] 3. Create an API key in Resend → API Keys (starts with `re_`).
#   [ ] 4. Set RESEND_API_KEY below to that real key (NOT the `re_xxxx` placeholder).
#   [ ] 5. Set RESEND_FROM_ADDR to an address on the verified domain
#          (e.g. noreply@your-company.com) — sending from a domain YOUR Resend
#          account has not verified fails. There is no default sender.
#   [ ] 6. Set APP_BASE_URL to the public frontend URL (verification links point here).
#   [ ] 7. Recreate the api-gateway so it picks up the key:
#          docker compose ... up -d --force-recreate api-gateway
#   [ ] 8. VERIFY: api-gateway logs one "email: Resend ..." line at startup.
#            docker compose ... logs api-gateway | grep 'email: Resend'
#          It must read "email: Resend configured, sending as <your address>".
#          Any other wording names the variable that is still missing. Then sign
#          up a fresh test account: you should be BLOCKED from full use until you
#          click the emailed link.
#   [ ] 9. (existing already-auto-verified accounts stay verified; only NEW
#          signups after the key is set are gated.)
RESEND_API_KEY=re_xxxxxxxxxxxx

# The public URL of your frontend app (used to build verification links).
# Users will see: <APP_BASE_URL>/verify-email?token=<token>
APP_BASE_URL=https://rsync.your-company.com

# Sender address — MUST be on a Resend-verified domain (required when RESEND_API_KEY is set).
RESEND_FROM_ADDR=noreply@your-company.com

# -----------------------------------------------------------------------------
# ADMIN PANEL
# -----------------------------------------------------------------------------
# Comma-separated list of email addresses with admin access
RSYNC_ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# NOTIFIER (pipeline failure notifications — Slack + Email)
# -----------------------------------------------------------------------------
# The notifier consumes rsync.notifications / rsync.healer.actions /
# rsync.healer.results from Kafka and delivers user-actionable alerts
# via Slack webhook and SMTP email.
#
# - Slack: set NOTIFIER_SLACK_WEBHOOK_URL to an incoming-webhook URL.
#   Leave empty to disable Slack delivery.
# - Email: set all four SMTP_* below + SMTP_FROM to enable.
#   Without these, notifications still persist to pipeline_notifications
#   (queryable by the UI) but no external delivery happens.
#
# When both channels are unset, the notifier runs in "persist-only" mode
# (delivery_status = 'suppressed' in pipeline_notifications) — useful
# for staging.
NOTIFIER_SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Slack one-click drift approvals (inbound interactivity) -----------------
# Lets a schema-drift Slack alert carry real Approve/Reject buttons that action
# the change without opening the app. This is OPT-IN and OFF by default: with
# both values unset the inbound receiver is inert and drift alerts keep the
# plain "View in rsync-ai" link button.
#
# To enable, in your Slack app (https://api.slack.com/apps):
#   [ ] 1. Enable Interactivity and set the Request URL to
#          https://<APP_BASE_URL host>/api/v1/slack/interactions
#   [ ] 2. Copy the app's Signing Secret -> SLACK_SIGNING_SECRET (this is what
#          verifies inbound requests actually came from Slack).
#   [ ] 3. Add the bot scope users:read.email, install the app, and copy the
#          Bot User OAuth Token (xoxb-...) -> SLACK_BOT_TOKEN. This maps the
#          clicking Slack user to their rsync account BY EMAIL, so a user's
#          Slack email must match their rsync login email; the mapped user must
#          also hold >= member in the pipeline's workspace to approve.
# Security: requests are rejected unless the Slack signature verifies; an
# unmapped or unauthorized identity is never allowed to approve.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# -----------------------------------------------------------------------------
# OAUTH PROVIDERS (optional — configure as needed)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# PIPEDRIVE_CLIENT_ID=
# PIPEDRIVE_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# PORTS (optional — override if defaults conflict)
# -----------------------------------------------------------------------------
# API_PORT=5001
# FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# CDC (optional — Change Data Capture)
# -----------------------------------------------------------------------------
# Enable Debezium connector recovery endpoint (default: false)
# CDC_RECOVERY_ENABLED=false

# -----------------------------------------------------------------------------
# MANAGED CONNECTORS (optional)
# -----------------------------------------------------------------------------
# Enable tool-generator to deploy connectors via Docker socket (default: false)
# Requires mounting /var/run/docker.sock to tool-generator container
# RSYNC_MANAGED_CONNECTORS=false

# -----------------------------------------------------------------------------
# MONITORING (optional)
# -----------------------------------------------------------------------------
# SigNoz UI URL for deep-link integration.
# Self-hosted SigNoz (deploy/signoz/docker) exposes its UI on host port 3301
# (host 8080 is owned by Traefik). Set this to the host's externally reachable
# SigNoz URL so the app's trace deep-links resolve.
# SIGNOZ_UI_URL=http://localhost:3301
# NEXT_PUBLIC_OTEL_ENDPOINT=

# Sentry error tracking (optional — Sentry is silently disabled if not set)
# Get your DSN from https://sentry.io → Project → Settings → Client Keys
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0   # server-side (same value)
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# SCHEMA-DRIFT DETECTION → APPROVE LOOP  (self-healing)
# -----------------------------------------------------------------------------
# When ON, each batch pipeline run snapshots the source schema and diffs it
# against the previous run's baseline. Any drift (add/drop/modify column, new/
# dropped table) is turned into a proposal that surfaces in the pipeline's
# "Schema Changes" tab for a human to approve or reject. Migration 068 creates
# the schema_baselines table automatically on api-gateway boot — no manual step.
#
#   OFF (unset)  → the loop is fully dormant (no detection, no baseline writes).
#   "true"       → detect + notify + queue for approval. Nothing is applied to
#                  the destination without a human clicking Approve.
#
# Recommended for launch: enable detection, leave auto-apply OFF, and watch the
# approval queue for a few days to confirm zero false positives before trusting
# any automatic application.
RSYNC_SCHEMA_DRIFT_ENABLED=true

# SEPARATE opt-in. When "true", changes the classifier deems SAFE (add_column,
# create_table) are applied to the destination automatically, WITHOUT waiting
# for approval. Destructive changes (drop/rename/retype) are NEVER auto-applied
# regardless of this flag — they always require approval and even then trip the
# destructive-DDL guard (surfaced honestly as "approved — apply manually").
# Leave OFF until the drift signal has soaked and you explicitly want additive
# changes to flow through untouched. Default OFF (any value other than "true").
RSYNC_SCHEMA_DRIFT_AUTOAPPLY=false

# -----------------------------------------------------------------------------
# LLM DIAGNOSER (optional — second-stage error classification)
# -----------------------------------------------------------------------------
# The rule-based diagnoser always runs first and is never bypassed. The LLM is
# consulted ONLY for an error the rules could not name (CategoryUnknown), and
# its confidence is clamped below the healer's auto-execute band — so an LLM
# diagnosis can reach a human for review but can never trigger an automatic
# action on its own. Any transport or decode failure falls back to the rules
# result, so the healer path never fails because the LLM did.
#
# PRIVACY: turning this ON sends failure text to the LLM service over the
# network. The error message passes llmscrub before it enters the prompt and
# everything else in the prompt is metadata (stage, connector types, row
# counts) — never row values, credentials, or PII. Leave it off unless you
# want that traffic.
#
# Default OFF (any value other than "true").
# RSYNC_LLM_DIAGNOSER_ENABLED=false

# Optional. Empty falls back to LLM_MODEL, then to gpt-4o-mini.
# RSYNC_LLM_DIAGNOSER_MODEL=

# Optional, and deliberately NOT named LLM_SERVICE_URL: that name is also read
# by the orchestrator's intent worker with a different default, so setting it
# would steer both. Empty falls back to LLM_SERVICE_URL, then to the value
# below.
# RSYNC_LLM_DIAGNOSER_URL=http://llm-service:5000
