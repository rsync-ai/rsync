# llm-service — environment example
# Copy to .env and fill in your values. NEVER commit .env to git.

# Azure OpenAI (recommended for production)
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<azure-key>
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

OPENAI_API_KEY=sk-proj-your-openai-key-here
ANTHROPIC_API_KEY=
# Logo.dev API token used by the connector logo downloader (img.logo.dev).
# Leave empty to skip the Logo.dev source; NEVER commit a real token.
LOGO_DEV_TOKEN=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
USE_MOCK_LLM=false
CONTEXT7_MCP_URL=http://context7-mcp:8080
OLLAMA_URL=http://host.docker.internal:11434
