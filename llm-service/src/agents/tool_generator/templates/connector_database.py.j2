    def load(self, params: Dict = None) -> Dict[str, Any]:
        """
        Warehouse bulk load (append) operation.

        Compatibility:
        - Delegates to non-DBAPI warehouse adapter when available.
        - Falls back to import_data (row inserts) for DB-API warehouses or small loads.
        """
        params = params or {}
        prepared = self.prepare_import_data(params)
        if not prepared.get("success", True):
            return prepared

        config = prepared["config"]
        table = prepared.get("table")
        data = prepared.get("data", [])
        if not table:
            return {"success": False, "error": "Target table not specified"}
        if not data:
            return {"success": True, "rows_loaded": 0, "message": "No data to load"}

        # Non-DBAPI warehouses (e.g., BigQuery) may implement bulk load in adapter.
        if getattr(self, "_warehouse_adapter", None) and hasattr(self._warehouse_adapter, "load"):
            adapter_params = dict(params)
            adapter_params.setdefault("table", table)
            adapter_params.setdefault("data", data)
            return self._warehouse_adapter.load(config, adapter_params)  # type: ignore[attr-defined]

        # Default: delegate to existing import_data.
        out = self.import_data(params)
        if isinstance(out, dict) and "rows_inserted" in out and "rows_loaded" not in out:
            out["rows_loaded"] = out.get("rows_inserted")
        return out

    def merge(self, params: Dict = None) -> Dict[str, Any]:
        """
        Warehouse merge (CDC apply) operation.

        Expected inputs (best-effort):
        - table: target table
        - data: rows to upsert; rows may include `_rsync_deleted` for soft deletes
        - key_fields: primary key columns for matching (required for correct CDC apply)

        NOTE: For non-DBAPI warehouses (BigQuery), the adapter is expected to implement merge.
        """
        params = params or {}
        prepared = self.prepare_import_data(params)
        if not prepared.get("success", True):
            return prepared

        config = prepared["config"]
        table = prepared.get("table")
        data = prepared.get("data", [])
        if not table:
            return {"success": False, "error": "Target table not specified"}
        if not data:
            return {"success": True, "rows_merged": 0, "message": "No data to merge"}

        # Non-DBAPI warehouses (e.g., BigQuery) should handle MERGE semantics in adapter.
        if getattr(self, "_warehouse_adapter", None) and hasattr(self._warehouse_adapter, "merge"):
            adapter_params = dict(params)
            adapter_params.setdefault("table", table)
            adapter_params.setdefault("data", data)
            return self._warehouse_adapter.merge(config, adapter_params)  # type: ignore[attr-defined]

        # Default fallback: upsert rows (may not be a true merge for all dialects).
        out = self.upsert_data(params)
        if isinstance(out, dict):
            out.setdefault("rows_merged", out.get("rows_upserted") or out.get("rows_inserted") or 0)
        return out

