        "mediumint": {"int", "bigint", "float", "double", "decimal", "text"},
        "int": {"bigint", "double", "decimal", "text"},
        "bigint": {"decimal", "text"},
        "float": {"double", "decimal", "text"},
        "double": {"decimal", "text"},
        "varchar": {"text", "mediumtext", "longtext"},
        "char": {"varchar", "text", "mediumtext", "longtext"},
        "text": {"mediumtext", "longtext"},
        "mediumtext": {"longtext"},
