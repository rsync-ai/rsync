    def _normalize_table_for_postgresql(self, config: Dict, table: str, params: Dict = None) -> str:
        """
        Normalize table identifiers for PostgreSQL.

        Rationale:
        - Callers sometimes (incorrectly) qualify tables with the database name (e.g. "mydb.users")
          while also providing config.database="mydb". PostgreSQL does not use db.table qualification.
        - Many call sites omit schema; Postgres defaults to the "public" schema.
        - A BARE table may arrive with the per-pipeline destination schema forwarded
          separately as ``params["namespace"]`` (the executor sends a bare name so
          single-namespace dests like MySQL resolve the DB from config). For Postgres
          the schema is load-bearing, so honor it here instead of defaulting to public.
        """
        t = (table or "").strip()
        if not t:
            return t

        module = (self.driver_pattern.get("module", "") or "").lower()
        # Only apply to the PostgreSQL driver path.
        if module != "psycopg2" and "postgres" not in module:
            return t

        db = str((config or {}).get("database") or "").strip()

        # Best-effort: strip outer quoting/backticks for prefix checks (keep inner segments intact).
        raw = t.strip('"').strip("`")
        if db:
            prefix = db.strip('"').strip("`") + "."
            # Repeatedly strip leading "<db>." to avoid db.db.table
            while raw.lower().startswith(prefix.lower()):
                raw = raw[len(prefix) :]

        # Default schema for Postgres is public unless explicitly provided. Honor an
        # explicit per-pipeline namespace (skip the planner's "default" placeholder;
        # identifier-validate to prevent injection) so bare-table writes land in the
        # right schema — mirrors drop_table and the mysql _split_mysql_db_table tier.
        if "." not in raw:
            ns = ""
            if params:
                ns = str(params.get("namespace") or params.get("db_or_schema") or "").strip().strip('"').strip("`")
            if ns and ns.lower() != "default" and self._is_safe_ident(ns):
                raw = ns + "." + raw
            else:
                raw = "public." + raw

        return raw

    def _is_safe_ident(self, s: str) -> bool:
        s = str(s or "").strip()
        if not s:
            return False
        # Conservative: unquoted SQL identifiers we generate must be simple.
        # fullmatch (not match) so a trailing newline can't slip past `$`.
        return re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", s) is not None

    def _split_schema_table(self, table: str):
        raw = str(table or "").strip()
        raw = raw.strip('"').strip("`")
        if "." in raw:
            parts = raw.split(".", 1)
            return parts[0].strip('"').strip("`"), parts[1].strip('"').strip("`")
        return "public", raw

    def _mk_index_name(self, schema: str, table: str, cols: List[str]) -> str:
        base = f"idx_{schema}_{table}_" + "_".join(cols[:2]) + "_uniq"
        base = re.sub(r"[^A-Za-z0-9_]+", "_", base)
        if len(base) <= 63:
            return base
        # Clamp and keep a short hash suffix for uniqueness.
        h = abs(hash(base)) % (10**8)
        return (base[:54] + f"_{h:08d}")[:63]

    def _normalize_ddl_type(self, t: str) -> str:
        """
        Normalize and validate a DDL type string to reduce SQL injection risk via type names.
        Allows multi-word types (e.g., "DOUBLE PRECISION") and optional precision/scale.
        Falls back to TEXT when invalid.
        """
        raw = str(t or "").strip()
        if not raw:
            return "TEXT"
        raw = re.sub(r"\s+", " ", raw).strip().upper()
        # Examples allowed:
        # - INTEGER
        # - DOUBLE PRECISION
        # - NUMERIC(38,2)
        # - VARCHAR(255)
        if not re.match(r"^[A-Z][A-Z0-9_ ]*(\([0-9]+(,[0-9]+)?\))?$", raw):
            return "TEXT"
        return raw

