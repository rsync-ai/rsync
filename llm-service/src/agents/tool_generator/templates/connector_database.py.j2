    def _widen_base(self, t: str, dialect: str) -> str:
        """Fold a DDL type OR an information_schema.data_type into the base keyword used
        as a _PG_WIDEN / _MYSQL_WIDEN key, per dialect, so current and desired compare on
        the same axis."""
        s = str(t or "").strip().lower()
        base = s.split("(")[0].strip()
        if dialect == "mysql":
            base = base.replace(" unsigned", "").replace(" zerofill", "").strip()
            return {"integer": "int", "boolean": "tinyint", "bool": "tinyint",
                    "double precision": "double", "character varying": "varchar",
                    "character": "char", "numeric": "decimal"}.get(base, base)
        return {"timestamptz": "timestamp with time zone",
                "timestamp": "timestamp without time zone",
                "varchar": "character varying", "char": "character", "bpchar": "character",
                "int": "integer", "int2": "smallint", "int4": "integer", "int8": "bigint",
                "float4": "real", "float8": "double precision", "bool": "boolean",
                "decimal": "numeric"}.get(base, base)

    def _widen_existing_columns(self, cursor, schema: str, name: str, safe_cols, ct, dialect: str) -> None:
        """Best-effort: ALTER existing columns whose type differs from the desired type
        when the change is a safe non-lossy widening (per the dialect widen map). ``schema``
        is the information_schema table_schema (the PG schema, or the MySQL database)."""
        widen = self._MYSQL_WIDEN if dialect == "mysql" else self._PG_WIDEN
        try:
            cursor.execute(
                "SELECT column_name, data_type FROM information_schema.columns "
                "WHERE table_schema=%s AND table_name=%s",
                (schema, name),
            )
            current_types = {}
            for row in cursor.fetchall() or []:
                if isinstance(row, dict):
                    cn = row.get("column_name") or row.get("COLUMN_NAME")
                    dt = row.get("data_type") or row.get("DATA_TYPE")
                else:
                    cn = row[0] if row and len(row) > 0 else None
                    dt = row[1] if row and len(row) > 1 else None
                if cn:
                    current_types[str(cn)] = str(dt or "").lower()
        except Exception:
            return  # information_schema not accessible → skip, never fail the write
        for c in safe_cols:
            if c not in ct:
                continue
            cur_base = self._widen_base(current_types.get(c, ""), dialect)
            if not cur_base:
                continue
            desired_ddl = self._normalize_ddl_type(ct.get(c, "TEXT"))
            des_base = self._widen_base(desired_ddl, dialect)
            if not des_base or des_base == cur_base:
                continue
            if des_base not in widen.get(cur_base, set()):
                continue
            try:
                if dialect == "mysql":
                    cursor.execute(f"ALTER TABLE `{schema}`.`{name}` MODIFY COLUMN `{c}` {desired_ddl}")
                else:
                    cursor.execute(
                        f'ALTER TABLE "{schema}"."{name}" '
                        f'ALTER COLUMN "{c}" TYPE {desired_ddl} USING "{c}"::{desired_ddl}'
                    )
            except Exception:
                pass  # a whitelisted widening casts in practice; leave as-is on failure

    def _ensure_table_for_cdc(self, cursor, table: str, columns: List[str], conflict_cols: List[str], column_types: Optional[Dict[str, str]] = None) -> None:
        """
        Best-effort: create missing schema/table for CDC upserts.

        This is intentionally conservative. When column_types are provided by the CDC sink worker,
        we use them; otherwise we default to TEXT.
        """
        schema, name = self._split_schema_table(table)
        if not self._is_safe_ident(schema) or not self._is_safe_ident(name):
            raise Exception(f"Unsafe destination identifier: {schema}.{name}")

        safe_cols = [c for c in (columns or []) if self._is_safe_ident(c)]
        if not safe_cols:
            raise Exception("No safe columns to create destination table")

        cursor.execute(f'CREATE SCHEMA IF NOT EXISTS "{schema}"')

        ct = column_types or {}
        col_defs = ", ".join([f'"{c}" {self._normalize_ddl_type(ct.get(c, "TEXT"))}' for c in safe_cols])
        cursor.execute(f'CREATE TABLE IF NOT EXISTS "{schema}"."{name}" ({col_defs})')

        # Add any missing columns (idempotent).
        for c in safe_cols:
            cursor.execute(
                f'ALTER TABLE "{schema}"."{name}" ADD COLUMN IF NOT EXISTS "{c}" {self._normalize_ddl_type(ct.get(c, "TEXT"))}'
            )

        # Safe-widen existing columns whose type evolved (best-effort; ADD COLUMN above
        # no-ops on an existing column, so this is what applies an in-place type change).
        self._widen_existing_columns(cursor, schema, name, safe_cols, ct, "postgresql")

        safe_conflict = [c for c in (conflict_cols or []) if self._is_safe_ident(c)]
        if safe_conflict:
            idx = self._mk_index_name(schema, name, safe_conflict)
            cols_sql = ", ".join([f'"{c}"' for c in safe_conflict])
            cursor.execute(f'CREATE UNIQUE INDEX IF NOT EXISTS "{idx}" ON "{schema}"."{name}" ({cols_sql})')
            # Set REPLICA IDENTITY USING INDEX so the table is publish-safe for
            # logical replication. This mirrors the postgresql hand-curated connector
            # (v1.0.14 ensure_table) and is required for Debezium to capture UPDATE/
            # DELETE events without error. No-op if the table is never a CDC source.
            # Port of fix from: shared/mcp-connectors/public/postgresql/versions/v1.0.14/connector.py
            try:
                cursor.execute(
                    f'ALTER TABLE "{schema}"."{name}" REPLICA IDENTITY USING INDEX "{idx}"'
                )
            except Exception:
                # Fallback: FULL is less efficient but always safe (no index required).
                try:
                    cursor.execute(f'ALTER TABLE "{schema}"."{name}" REPLICA IDENTITY FULL')
                except Exception:
                    pass  # Non-fatal: table may be on a read-replica or REPLICA IDENTITY already set

    def _split_mysql_db_table(self, config: Dict, table: str, params: Dict = None):
        # Centralized (database, bare_table) resolver. Precedence:
        #   1. qualified "db.table" in the spec      2. params["namespace"]/["db_or_schema"]
        #   (per-pipeline destination namespace, skipping the planner's "default"
        #   placeholder, identifier-validated)        3. config["database"] default.
        # Also collapses accidental double-qualification (db.db.table). Kept in
        # lockstep with the hand-curated mysql connector's _split_mysql_db_table.
        raw = str(table or "").strip().strip("`").strip('"')
        config = config or {}
        config_db = str(config.get("database") or config.get("db_name") or "").strip().strip("`").strip('"')
        if "." in raw:
            db = raw.split(".", 1)[0].strip("`").strip('"')
            name = raw.split(".", 1)[1].strip("`").strip('"')
            prefix = db + "."
            while name.lower().startswith(prefix.lower()) and len(name) > len(prefix):
                name = name[len(prefix):]
            return db, name
        if params:
            ns = str(params.get("namespace") or params.get("db_or_schema") or "").strip().strip('"').strip("`")
            if ns and ns.lower() != "default" and self._is_safe_ident(ns):
                return ns, raw
        return config_db, raw

    def _ensure_table_for_mysql(self, cursor, config: Dict, table: str, columns: List[str], key_fields: List[str], column_types: Optional[Dict[str, str]] = None, params: Dict = None) -> None:
        # Pass params so the per-pipeline namespace resolves the target database
        # (table is bare; the namespace travels separately from the sink).
        db, name = self._split_mysql_db_table(config, table, params)
        if not db or not self._is_safe_ident(db) or not self._is_safe_ident(name):
            raise Exception(f"Unsafe or missing database/table identifier: {db}.{name}")

        safe_cols = [c for c in (columns or []) if self._is_safe_ident(c)]
        if not safe_cols:
            raise Exception("No safe columns to create destination table")

        # Ensure database exists
        cursor.execute(f"CREATE DATABASE IF NOT EXISTS `{db}`")

        ct = column_types or {}
        col_defs = ", ".join([f"`{c}` {self._normalize_ddl_type(ct.get(c, 'TEXT'))}" for c in safe_cols])
        cursor.execute(f"CREATE TABLE IF NOT EXISTS `{db}`.`{name}` ({col_defs})")

        # Add missing columns (best-effort by querying information_schema)
        try:
            cursor.execute(
                "SELECT column_name FROM information_schema.columns WHERE table_schema=%s AND table_name=%s",
                (db, name),
            )
            existing = set()
            for row in cursor.fetchall() or []:
                # mysql dict cursor vs tuple cursor
                if isinstance(row, dict):
                    v = row.get("column_name") or row.get("COLUMN_NAME")
                else:
                    v = row[0] if row else None
                if v:
                    existing.add(str(v))
            for c in safe_cols:
                if c in existing:
                    continue
                cursor.execute(f"ALTER TABLE `{db}`.`{name}` ADD COLUMN `{c}` {self._normalize_ddl_type(ct.get(c, 'TEXT'))}")
        except Exception:
            # If information_schema isn't accessible, avoid failing the write path.
            pass

        # Safe-widen existing columns whose type evolved (best-effort; the ADD COLUMN
        # loop above only adds NEW columns, so this applies an in-place type change).
        self._widen_existing_columns(cursor, db, name, safe_cols, ct, "mysql")

        safe_keys = [c for c in (key_fields or []) if self._is_safe_ident(c)]
        if safe_keys:
            idx = self._mk_index_name(db, name, safe_keys)
            # MySQL doesn't support CREATE UNIQUE INDEX IF NOT EXISTS; check by name.
            try:
                cursor.execute(
                    "SELECT 1 FROM information_schema.statistics WHERE table_schema=%s AND table_name=%s AND index_name=%s LIMIT 1",
                    (db, name, idx),
                )
                row = cursor.fetchone()
                if not row:
                    cols_sql = ", ".join([f"`{c}`" for c in safe_keys])
                    cursor.execute(f"CREATE UNIQUE INDEX `{idx}` ON `{db}`.`{name}` ({cols_sql})")
            except Exception:
                # Best-effort: do not fail table creation if index creation fails.
                pass

    # =========================================================================
    # DDL HELPERS (optional; only called when connector advertises support)
    # =========================================================================

    def ensure_schema(self, params: Dict = None) -> Dict[str, Any]:
        if self._is_sqlserver_dialect():
            return self._ss_ensure_schema(params)
        if not bool(getattr(self, "supports_ddl", False)):
            return {"success": False, "error": "DDL helpers not supported by this connector"}
        params = params or {}
        config = self._get_config(params)
        schema = str(params.get("schema") or "").strip()
        if not schema:
            return {"success": False, "error": "Missing schema"}
        if not self._is_safe_ident(schema):
            return {"success": False, "error": f"Unsafe schema identifier: {schema}"}

        module = (self.driver_pattern.get("module", "") or "").lower()
        conn = None
        cursor = None
        try:
            conn = self._get_connection(config)
            cursor = self._get_cursor(conn, as_dict=False)
            if "psycopg2" in module or "postgres" in module:
                cursor.execute(f'CREATE SCHEMA IF NOT EXISTS "{schema}"')
            elif "mysql" in module:
                cursor.execute(f"CREATE DATABASE IF NOT EXISTS `{schema}`")
            else:
                return {"success": False, "error": f"ensure_schema not implemented for driver: {module or 'generic'}"}
            try:
                conn.commit()
            except Exception:
                pass
            return {"success": True, "schema": schema}
        finally:
            try:
                if cursor is not None:
                    cursor.close()
            except Exception:
                pass
            try:
                if conn is not None:
                    conn.close()
            except Exception:
                pass

    def ensure_table(self, params: Dict = None) -> Dict[str, Any]:
        if self._is_sqlserver_dialect():
            return self._ss_ensure_table(params)
        if not bool(getattr(self, "supports_ddl", False)):
            return {"success": False, "error": "DDL helpers not supported by this connector"}
        params = params or {}
        config = self._get_config(params)
        table = str(params.get("table") or "").strip()
        if not table:
            return {"success": False, "error": "Missing table"}

        cols_raw = params.get("columns") or []
        columns: List[str] = []
        if isinstance(cols_raw, list):
            for c in cols_raw:
                cc = str(c or "").strip()
                if cc:
                    columns.append(cc)

        keys_raw = params.get("key_fields") or params.get("keys") or []
        key_fields: List[str] = []
        if isinstance(keys_raw, list):
            for c in keys_raw:
                cc = str(c or "").strip()
                if cc:
                    key_fields.append(cc)

        # Optional: typed DDL mapping from CDC sink worker.
        ct_raw = params.get("column_types") or params.get("columnTypes") or {}
        column_types: Dict[str, str] = {}
        if isinstance(ct_raw, dict):
            for k, v in ct_raw.items():
                kk = str(k or "").strip()
                vv = str(v or "").strip()
                if kk:
                    column_types[kk] = vv

        module = (self.driver_pattern.get("module", "") or "").lower()
        conn = None
        cursor = None
        try:
            conn = self._get_connection(config)
            cursor = self._get_cursor(conn, as_dict=False)
            if "psycopg2" in module or "postgres" in module:
                norm = self._normalize_table_for_postgresql(config, table, params)
                self._ensure_table_for_cdc(cursor, norm, columns, key_fields, column_types)
            elif "mysql" in module:
                self._ensure_table_for_mysql(cursor, config, table, columns, key_fields, column_types, params)
            else:
                return {"success": False, "error": f"ensure_table not implemented for driver: {module or 'generic'}"}
            try:
                conn.commit()
            except Exception:
                pass
            return {"success": True, "table": table}
        finally:
            try:
                if cursor is not None:
                    cursor.close()
            except Exception:
                pass
            try:
                if conn is not None:
                    conn.close()
            except Exception:
                pass
    
    def drop_table(self, params: Dict = None) -> Dict[str, Any]:
        if self._is_sqlserver_dialect():
            return self._ss_drop_table(params)
        """DROP destination table for run_mode=reload.

        Reload semantics are "rebuild from scratch": data + schema both
        regenerated from the latest source state. TRUNCATE is wrong —
        it preserves stale columns and type drift.

        DROP TABLE IF EXISTS ... CASCADE matches DMS / Fivetran / Airbyte
        full-load semantics.

        Params:
            config:   Database connection config.
            table:    Destination table (optionally schema-qualified).
            cascade:  bool, default true.

        Returns ``{success, table, dropped: bool}``. Missing-table is a
        success-no-op so the reload path is idempotent on first run.
        """
        if not bool(getattr(self, "supports_ddl", False)):
            return {"success": False, "error": "DDL helpers not supported by this connector"}
        params = params or {}
        config = self._get_config(params)
        table = str(params.get("table") or "").strip()
        if not table:
            return {"success": False, "error": "Missing table"}

        cascade_clause = " CASCADE"
        if params.get("cascade") is False:
            cascade_clause = ""

        module = (self.driver_pattern.get("module", "") or "").lower()
        conn = None
        cursor = None
        try:
            conn = self._get_connection(config)
            cursor = self._get_cursor(conn, as_dict=False)
            if "psycopg2" in module or "postgres" in module:
                parts = table.rsplit(".", 1)
                if len(parts) == 2:
                    drop_sql = f'DROP TABLE IF EXISTS "{parts[0]}"."{parts[1]}"{cascade_clause}'
                else:
                    # Bare (unqualified) table: the executor forwards the
                    # destination schema separately as `namespace` (it sends a
                    # bare name so single-namespace dests like MySQL resolve the
                    # DB from config). For PostgreSQL the schema is load-bearing —
                    # an unqualified DROP resolves against search_path (public),
                    # so a reload of a namespaced table would no-op and leave
                    # stale rows. Honor `namespace` when present; skip the literal
                    # "default" (planner fallback → those land in public).
                    ns = str(params.get("namespace") or "").strip().strip('"').strip("`")
                    if ns and ns.lower() != "default":
                        drop_sql = f'DROP TABLE IF EXISTS "{ns}"."{table}"{cascade_clause}'
                    else:
                        drop_sql = f'DROP TABLE IF EXISTS "{table}"{cascade_clause}'
                cursor.execute(drop_sql)
            elif "mysql" in module:
                tbl = table.rsplit(".", 1)[-1] if "." in table else table
                # MySQL: the database is the namespace. A qualified spec
                # (db.table) carries it; a bare spec forwards the per-pipeline
                # destination database as `namespace` (the executor sends a bare
                # name on purpose). Honor it so the reload DROP hits the same
                # database the sink INSERTs into — otherwise drop falls back to
                # the connection's default DB and drifts from the data. Skip the
                # literal "default" (planner fallback). Mirrors the PG branch.
                ns_db = None
                if "." in table:
                    ns_db = table.rsplit(".", 1)[0]
                else:
                    ns = str(params.get("namespace") or "").strip().strip('"').strip("`")
                    if ns and ns.lower() != "default":
                        ns_db = ns
                if ns_db:
                    cursor.execute(f"DROP TABLE IF EXISTS `{ns_db}`.`{tbl}`{cascade_clause}")
                else:
                    cursor.execute(f"DROP TABLE IF EXISTS `{tbl}`{cascade_clause}")
            else:
                return {"success": False, "error": f"drop_table not implemented for driver: {module or 'generic'}"}
            try:
                conn.commit()
            except Exception:
                pass
            return {"success": True, "table": table, "dropped": True}
        except Exception as exc:
            return {"success": False, "error": str(exc)}
        finally:
            try:
                if cursor is not None:
                    cursor.close()
            except Exception:
                pass
            try:
                if conn is not None:
                    conn.close()
            except Exception:
                pass

    def _get_connection(self, config: Dict):
        """
        Establish database connection using detected driver pattern.
        
        This method dynamically loads and uses the appropriate database driver
        based on the connector type.
        """
        pattern = self.driver_pattern
        
        if not pattern:
            raise NotImplementedError(
                f"No driver pattern found for {self.connector_type}. "
                "Please add a pattern to DRIVER_PATTERNS or use a specific template."
            )
        
        try:
            # Import the driver module
            module_name = pattern.get("module", "")
            if not module_name:
                raise ImportError(f"No module specified for driver")
            
            import importlib
            driver_module = importlib.import_module(module_name)
            
            # Handle different connection styles
            if pattern.get("is_nosql"):
                return self._get_nosql_connection(driver_module, pattern, config)
            elif pattern.get("connection_string"):
                return self._get_connection_string_style(driver_module, pattern, config)
            else:
                return self._get_param_style_connection(driver_module, pattern, config)
                
        except ImportError as e:
            raise Exception(f"Database driver not installed: {e}. Install with: pip install {pattern.get('module', 'driver')}")
        except Exception as e:
            raise Exception(f"Database connection failed: {e}")
    
    def _get_param_style_connection(self, driver_module, pattern: Dict, config: Dict):
        """Standard parameter-based connection (MySQL, PostgreSQL, etc.)"""
        connect_path = pattern.get("connect", "connect")
        
        # Extract the function name from the connect path
        # For "mysql.connector.connect", the module is already imported as "mysql.connector"
        # So we just need the last part: "connect"
        # For "psycopg2.connect", module is "psycopg2", we need "connect"
        if "." in connect_path:
            # Get the last part of the path (the actual function name)
            func_name = connect_path.split(".")[-1]
            connect_func = getattr(driver_module, func_name)
        else:
            # Simple case: just "connect"
            connect_func = getattr(driver_module, connect_path)
        
        # Build connection params
        conn_params = {}
        for param in pattern.get("params", []):
            # Map config keys to driver-specific param names
            if param == "dbname":  # PostgreSQL uses dbname
                conn_params[param] = config.get("database")
            else:
                if config.get(param):
                    conn_params[param] = config.get(param)
        
        # Add default port if not specified
        if "port" not in conn_params and pattern.get("default_port"):
            conn_params["port"] = pattern["default_port"]

        # Add connect timeout so unreachable hosts fail fast (better UX for "Test Connection")
        module_lower = (pattern.get("module", "") or "").lower()
        if "mysql" in module_lower:
            # Force a strict SQL mode so a type/length mismatch against a drifted
            # destination column RAISES instead of being silently truncated/coerced
            # (a permissive server stored a too-long value truncated, returned no
            # error, and the pipeline "completed" with corrupted data). Don't depend
            # on the server's sql_mode. An explicit config sql_mode always wins.
            # Gated on "mysql" (matches "pymysql" and "mysql.connector"), NOT the exact
            # driver string: this is a data-integrity guarantee, not a transport detail,
            # and must survive a driver swap.
            conn_params.setdefault("sql_mode", config.get("sql_mode") or "STRICT_ALL_TABLES")
        if "pymysql" in module_lower:
            # pymysql-specific transport tuning: connect_timeout kwarg so unreachable
            # hosts fail fast on "Test Connection" (mysql.connector uses connection_timeout).
            conn_params.setdefault("connect_timeout", 10)
        elif module_lower == "psycopg2":
            # psycopg2 uses connect_timeout (seconds)
            conn_params.setdefault("connect_timeout", 10)

        # Host-aware, VERIFY/secure-by-default TLS — mirrors the #625 hand-curated
        # connectors (mysql/postgresql/redshift/oracle) and the Go api-gateway/
        # orchestrator resolvers (resolveMySQLTLSMode / ResolvePostgresSSLMode /
        # resolveSQLServerEncrypt). A REMOTE host defaults to TLS that VERIFIES the
        # server cert (CA + hostname), closing the MITM/plaintext window; local/
        # docker-internal hosts stay plaintext (they rarely run a TLS listener). An
        # explicit ssl_mode/sslmode/tls key always wins and is honored per-value:
        # disable-family -> off; require/prefer/skip-verify -> encrypt without verify;
        # verify-ca/verify-full -> verify. _is_local_db_host is IP-literal-aware, so an
        # IPv6 or public-IPv4 literal is remote->verify (not textual "."->plaintext).
        host_val = str(config.get("host", "") or "").strip().lower()
        is_local_host = _is_local_db_host(host_val)
        _ssl_mode = ""
        for _k in ("ssl_mode", "sslmode", "tls", "tls_mode"):
            _v = str(config.get(_k) or "").strip().lower()
            if _v:
                _ssl_mode = _v
                break
        if "pymysql" in module_lower:
            # PyMySQL does NOT negotiate TLS from a bare connection — a remote server
            # enforcing require_secure_transport (Azure Database for MySQL, RDS) rejects
            # a plaintext connection — so pass an SSL context. Default for a remote host
            # = VERIFY the server cert (CA + hostname) against the image trust store
            # (python:slim ships ca-certificates incl. the Azure DigiCert/Microsoft
            # roots), closing the MITM window that CERT_NONE left open. Opt out (encrypt,
            # no verify) with ssl_mode=require for a server whose CA is not in the store.
            import ssl as _ssl
            if _ssl_mode in ("disable", "disabled", "false", "off", "0", "none") or (
                not _ssl_mode and is_local_host
            ):
                conn_params.setdefault("ssl_disabled", True)
            else:
                _ctx = _ssl.create_default_context()
                if _ssl_mode in ("require", "required", "skip-verify", "skip_verify", "prefer", "preferred"):
                    # Opt-out: encrypt in transit WITHOUT CA/hostname verification.
                    _ctx.check_hostname = False
                    _ctx.verify_mode = _ssl.CERT_NONE
                # else default remote OR verify-ca/verify-full/true -> full CA+hostname verify.
                conn_params.setdefault("ssl", _ctx)
        elif "oracledb" in module_lower:
            # Oracle thin-mode default is PROTOCOL=TCP (plaintext :1521) — a remote login
            # + every row would go cleartext. Default a remote host to PROTOCOL=TCPS
            # (Oracle native TLS); keep local/docker-internal on TCP. A disable-family
            # value forces plaintext TCP; any other explicit value opts in. Port is NOT
            # rewritten (TCPS conventionally 2484): TCPS fails-closed if there is no TLS
            # listener, which is strictly safer than silently leaking creds over plaintext.
            _oproto = str(
                config.get("protocol") or _ssl_mode or ""
            ).strip().lower()
            if _oproto in ("disable", "disabled", "false", "off", "0", "no", "none", "tcp"):
                use_tcps = False
            elif _oproto:  # tcps / require / true / verify-* / … -> opt in
                use_tcps = True
            else:
                use_tcps = not is_local_host
            if use_tcps:
                conn_params.setdefault("protocol", "tcps")
        elif module_lower == "psycopg2":
            # psycopg2/libpq: the only TLS knob is sslmode. Forward an explicit
            # ssl_mode/sslmode verbatim ("explicit wins"). No explicit value -> default
            # a REMOTE host to verify-full (encrypt AND verify cert+hostname) — bare
            # "require" only encrypts, letting a MITM with a self-signed cert harvest
            # creds+rows — and point sslrootcert at the OS CA bundle (libpq's default
            # ~/.postgresql/root.crt is absent in-image), so a cloud PG/Redshift cert
            # verifies. Local -> disable. Mirrors the redshift connector + Go resolver.
            explicit_sslmode = config.get("sslmode") or config.get("ssl_mode")
            if explicit_sslmode not in (None, ""):
                conn_params["sslmode"] = str(explicit_sslmode)
            elif is_local_host:
                conn_params.setdefault("sslmode", "disable")
            else:
                conn_params.setdefault("sslmode", "verify-full")
                # Injected ONLY when WE defaulted to verify-full and the user gave no
                # sslrootcert; an explicit mode/cert is left untouched.
                if not config.get("sslrootcert"):
                    conn_params.setdefault("sslrootcert", "/etc/ssl/certs/ca-certificates.crt")

        return connect_func(**conn_params)
    
    def _get_connection_string_style(self, driver_module, pattern: Dict, config: Dict):
        """Connection-string based connection (SQL Server via pyodbc).

        Encryption is host-aware: Azure SQL (``*.database.windows.net``) MANDATES
        TLS and presents a real CA cert (Encrypt=yes + TrustServerCertificate=no);
        boxed/local SQL Server usually has a self-signed cert (Encrypt=yes +
        TrustServerCertificate=yes). An explicit ``encrypt``/``sslmode``/``tls``
        config key wins. Without this, ODBC Driver 17's default (Encrypt=no) fails
        against Azure. pyodbc uses '?' qmark paramstyle (see export/discovery).
        """
        import pyodbc

        # Prefer the newest installed "ODBC Driver NN for SQL Server" (18 defaults
        # Encrypt=yes, which Azure requires); fall back to 17.
        driver = "ODBC Driver 18 for SQL Server"
        try:
            installed = [d for d in pyodbc.drivers() if "ODBC Driver" in d and "SQL Server" in d]
            if installed:
                def _ver(name):
                    for tok in name.split():
                        if tok.isdigit():
                            return int(tok)
                    return 0
                driver = sorted(installed, key=_ver)[-1]
        except Exception:
            pass

        host = str(config.get("host", "localhost") or "localhost")
        port = config.get("port", 1433) or 1433
        server = f"{host},{port}"
        database = config.get("database", "master") or "master"
        uid = config.get("user", "") or config.get("username", "") or ""
        pwd = config.get("password", "") or ""

        host_l = host.strip().lower()
        is_azure = host_l.endswith(".database.windows.net")
        # Host-aware encryption; explicit config wins and is honored per-value (mirrors
        # the #625 sqlserver connector + orchestrator resolveSQLServerEncrypt). pyodbc:
        # Encrypt=yes/no + TrustServerCertificate=yes(skip verify)/no(verify CA+host).
        # Azure presents a real DigiCert CA -> Encrypt=yes + TrustServerCertificate=no
        # (verify). A local/boxed server typically has a self-signed cert -> encrypt
        # without verify. Remote non-Azure defaults to Encrypt=yes +
        # TrustServerCertificate=no (verify), closing the encrypt-without-verify MITM
        # window; an on-prem self-signed box opts out with sslmode=require.
        raw_tls = str(
            config.get("encrypt") or config.get("sslmode") or config.get("tls") or config.get("tls_mode") or ""
        ).strip().lower()
        if raw_tls:
            if raw_tls in ("disable", "disabled", "false", "no", "off", "0", "none"):
                encrypt, trust = "no", "no"        # TLS off
            elif raw_tls in ("require", "required", "prefer", "preferred",
                             "skip-verify", "skip_verify", "true", "on", "1"):
                encrypt, trust = "yes", "yes"      # encrypt, opt out of verification
            else:
                # verify-ca / verify-full / verify-identity / strict (and any
                # unrecognized value): encrypt AND verify the server cert.
                encrypt, trust = "yes", "no"
        elif is_azure:
            encrypt, trust = "yes", "no"           # real DigiCert CA -> verify it
        elif _is_local_db_host(host):
            encrypt, trust = "yes", "yes"          # self-signed box cert -> don't verify
        else:
            encrypt, trust = "yes", "no"           # remote non-Azure -> encrypt AND verify

        # Build "{ODBC Driver NN for SQL Server}" via concat (single braces) so
        # this stays valid in the Jinja template that renders the connector.
        driver_spec = "{" + driver + "}"
        conn_str = ";".join([
            f"DRIVER={driver_spec}",
            f"SERVER={server}",
            f"DATABASE={database}",
            f"UID={uid}",
            f"PWD={pwd}",
            f"Encrypt={encrypt}",
            f"TrustServerCertificate={trust}",
            "Connection Timeout=10",
        ])
        return pyodbc.connect(conn_str)
    
    def _get_nosql_connection(self, driver_module, pattern: Dict, config: Dict):
        """NoSQL database connection (MongoDB, Redis, etc.)"""
        module_name = pattern.get("module", "")
        
        if "mongo" in module_name:
            from pymongo import MongoClient
            host = config.get('host', 'localhost')
            port = config.get('port', 27017)
            user = config.get('user')
            password = config.get('password')
            
            # Secure-by-default TLS (mirrors the #625 mongodb connector): Atlas
            # (mongodb.net) always uses TLS; an explicit ssl/tls disable-family value
            # opts out; an explicit enable/verify value turns it on; otherwise default
            # REMOTE hosts to TLS (a self-hosted remote Mongo previously connected over
            # plaintext mongodb://, so a passive eavesdropper could read every
            # document/PII off the wire) and keep local/docker-internal hosts plaintext.
            _mongo_ssl = str(
                config.get('sslmode') or config.get('ssl_mode') or config.get('ssl')
                or config.get('tls') or ''
            ).strip().lower()
            if 'mongodb.net' in str(host).lower():
                want_tls = True
            elif _mongo_ssl in ('disable', 'disabled', 'false', 'off', '0', 'none'):
                want_tls = False
            elif _mongo_ssl in ('require', 'required', 'true', 'on', 'prefer', 'preferred',
                                'verify-ca', 'verify_ca', 'verify-full', 'verify-identity', 'verify_identity'):
                want_tls = True
            elif not _mongo_ssl:
                want_tls = not _is_local_db_host(host)
            else:
                want_tls = False  # unrecognized explicit value -> preserve prior (off)
            _mongo_params = []
            if user and password:
                _mongo_params.append(f"authSource={config.get('auth_source', 'admin')}")
            if want_tls:
                _mongo_params.append("tls=true")
            _mongo_query = ("?" + "&".join(_mongo_params)) if _mongo_params else ""
            if user and password:
                uri = f"mongodb://{user}:{password}@{host}:{port}/{_mongo_query}"
            else:
                uri = f"mongodb://{host}:{port}/{_mongo_query}"
            
            return MongoClient(uri)
        
        elif "redis" in module_name:
            import redis
            return redis.Redis(
                host=config.get('host', 'localhost'),
                port=config.get('port', 6379),
                password=config.get('password'),
                db=config.get('db', 0)
            )
        
        else:
            raise NotImplementedError(f"NoSQL driver {module_name} not yet supported")
    
    def _get_cursor(self, conn, as_dict: bool = True):
        """Get cursor with optional dictionary mode"""
        pattern = self.driver_pattern
        
        # MongoDB doesn't use cursors the same way
        if pattern.get("is_nosql"):
            return None
        
        # SQLite special handling
        if "sqlite" in pattern.get("module", ""):
            import sqlite3
            if as_dict:
                conn.row_factory = sqlite3.Row
            return conn.cursor()
        
        # PostgreSQL special handling
        if "psycopg2" in pattern.get("module", ""):
            from psycopg2.extras import RealDictCursor
            return conn.cursor(cursor_factory=RealDictCursor) if as_dict else conn.cursor()
        
        # MySQL special handling (PyMySQL)
        if "mysql" in pattern.get("module", ""):
            if as_dict:
                from pymysql.cursors import DictCursor
                return conn.cursor(DictCursor)
            return conn.cursor()
        
        # Default cursor
        return conn.cursor()

    def _coerce_row_count(self, value, default=None):
        """
        Best-effort coercion for row/item counts coming from catalog/stats.

        - Returns an int when possible
        - Clamps negative values to 0 (some engines/stats can surface -1/invalid)
        - Returns `default` for missing/unparseable values
        """
        if value is None:
            return default
        try:
            # Fast-path for common numeric types
            i = int(value)
        except Exception:
            try:
                # Some drivers return Decimal/float/string-ish values; fall back.
                i = int(float(value))
            except Exception:
                return default
        if i < 0:
            return 0
        return i
    
