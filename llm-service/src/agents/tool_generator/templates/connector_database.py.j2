    def import_data(self, params: Dict = None):
        if self._is_sqlserver_dialect():
            return self._ss_import_data(params)
        """Import data into database"""
        prepared = self.prepare_import_data(params)
        
        if not prepared.get('success', True):
            return prepared
        
        data = prepared.get('data', [])
        if not data:
            return {"success": True, "rows_inserted": 0, "message": "No data to import"}
        
        config = prepared['config']
        table = prepared.get('table')
        
        if not table:
            return {"success": False, "error": "Target table not specified"}
        # PostgreSQL normalization is a no-op for other drivers. Pass params so a
        # bare table + per-pipeline namespace lands in the right schema.
        table = self._normalize_table_for_postgresql(config, table, params)
        # Fail-closed write-path SQLi guard: for a driver that is neither MySQL
        # nor Postgres (the branches below), `table` stays the raw, tenant-
        # controlled value and is interpolated raw into the INSERT at the bottom.
        # Reject an unsafe identifier before ANY raw {table} interpolation —
        # mirrors the read-path (export) guard.
        if self._safe_qualified_table(table) is None:
            return {"success": False, "error": f"Unsafe table identifier: {table!r}"}

        # MySQL-family: the database IS the namespace. Resolve (db, bare_table)
        # honoring the per-pipeline namespace the sink forwards alongside a bare
        # table, then build a backtick-qualified target — mirrors the hand-curated
        # mysql connector. normalize_table_for_postgresql is a no-op for mysql, so
        # `table` is still the original spec here. _col_q quotes columns to match.
        _mod = (self.driver_pattern.get("module", "") or "").lower()
        _col_q = '"'
        if "mysql" in _mod or "pymysql" in _mod:
            _db, _name = self._split_mysql_db_table(config, table, params)
            if not _name or not self._is_safe_ident(_name):
                return {"success": False, "error": f"Unsafe or missing table identifier: {_name}"}
            if _db and not self._is_safe_ident(_db):
                return {"success": False, "error": f"Unsafe database identifier: {_db}"}
            table = f"`{_db}`.`{_name}`" if _db else f"`{_name}`"
            _col_q = '`'
        elif "psycopg2" in _mod or "postgres" in _mod:
            # Postgres: build a double-quoted "schema"."table" so a case-sensitive
            # table (e.g. camelCase from a GraphQL/REST source) matches the
            # case-preserved relation ensure_table() created. Unquoted, Postgres
            # folds it to lowercase, every write misses the table and lands in the
            # DLQ — while the columns (quoted via _col_q) match. Mirrors mysql above.
            _pg_schema, _pg_name = self._split_schema_table(table)
            if not self._is_safe_ident(_pg_schema) or not self._is_safe_ident(_pg_name):
                return {"success": False, "error": f"Unsafe destination identifier: {_pg_schema}.{_pg_name}"}
            table = f'"{_pg_schema}"."{_pg_name}"'

        # Non-DBAPI warehouses (e.g., BigQuery) delegate import to an adapter.
        # Prefer the bulk-first `load` path (flag-gated NDJSON load job with an
        # internal streaming fallback) when the adapter exposes it — mirrors the
        # hand-curated bigquery connector's optimized write routing. Falls back to
        # per-row `import_data` (streaming) for adapters without a bulk path.
        if getattr(self, "_warehouse_adapter", None):
            adapter_params = dict(params or {})
            adapter_params.setdefault("table", table)
            adapter_params.setdefault("data", data)
            if hasattr(self._warehouse_adapter, "load"):
                return self._warehouse_adapter.load(config, adapter_params)
            return self._warehouse_adapter.import_data(config, adapter_params)
        
        conn = None
        try:
            conn = self._get_connection(config)
            pattern = self.driver_pattern
            
            # Handle NoSQL
            if pattern.get("is_nosql"):
                return self._import_nosql(conn, config, table, data)
            
            # SQL import
            cursor = self._get_cursor(conn, as_dict=False)
            
            if data:
                # Union keys across ALL rows (ragged-row safe; see upsert_data).
                columns = []
                _seen_cols = set()
                for _row in data:
                    if not isinstance(_row, dict):
                        continue
                    for _k in _row.keys():
                        if _k not in _seen_cols:
                            _seen_cols.add(_k)
                            columns.append(_k)
                placeholders = ", ".join(["%s"] * len(columns))
                # Quote column identifiers consistently with table creation
                # (which quotes via "{col}"). Without quoting, Postgres folds
                # camelCase columns to lowercase at INSERT time and the column
                # lookup fails against the quoted-case schema created earlier.
                # _col_q is backtick for MySQL, double-quote for Postgres.
                for c in columns:
                    if not self._is_safe_ident(c):
                        return {"success": False, "error": f"Unsafe column identifier: {c}"}
                col_str = ", ".join([f'{_col_q}{c}{_col_q}' for c in columns])

                insert_query = f"INSERT INTO {table} ({col_str}) VALUES ({placeholders})"
                
                # Batch insert
                rows_inserted = 0
                batch_size = min(self.max_batch_size, 1000)
                
                for i in range(0, len(data), batch_size):
                    batch = data[i:i + batch_size]
                    values = [tuple(row.get(col) for col in columns) for row in batch]
                    cursor.executemany(insert_query, values)
                    # Count rows the DB actually wrote (cursor.rowcount), NOT len(batch).
                    # Returning len(batch) unconditionally masks silent data loss: a write
                    # that affected 0 rows still reports success+N, the sink ack's it, and
                    # the pipeline reports "completed" with 0 rows landed. Fall back to
                    # len(batch) only when the driver doesn't report a count (rowcount < 0).
                    affected = cursor.rowcount
                    rows_inserted += affected if (affected is not None and affected >= 0) else len(batch)

                # Diagnostic: resolved target + submitted-vs-affected. A shortfall
                # (affected < submitted) is the silent-data-loss signature.
                logger.info(
                    "import_data: target=%s submitted=%d affected=%d",
                    table, len(data), rows_inserted,
                )

                # Record the Kafka high-water offset in the SAME transaction as the
                # insert so data + progress stay atomic (exactly-once for append-only
                # CDC, replaces Redis dedup). No-op for full-load callers, which do not
                # supply ``kafka_offset``.
                self._write_cdc_offsets(cursor, params)
                conn.commit()

            cursor.close()
            return {"success": True, "rows_inserted": rows_inserted}
            
        except Exception as e:
            if conn:
                try:
                    conn.rollback()
                except:
                    pass
            return {"success": False, "error": str(e)}
        finally:
            if conn:
                try:
                    conn.close()
                except:
                    pass
    
    def _dest_pk_columns(self, cursor, schema: str, name: str) -> List[str]:
        """PRIMARY KEY column names of an EXISTING destination table (in key
        order), or [] when the table has no PK / doesn't exist yet. Probed in a
        SAVEPOINT so a miss can't poison the caller's transaction."""
        try:
            cursor.execute("SAVEPOINT _rsync_pk_probe")
            cursor.execute(
                "SELECT a.attname FROM pg_index i "
                "JOIN pg_attribute a ON a.attrelid = i.indrelid "
                "AND a.attnum = ANY(i.indkey) "
                "WHERE i.indrelid = %s::regclass AND i.indisprimary "
                "ORDER BY array_position(i.indkey, a.attnum)",
                (f'"{schema}"."{name}"',),
            )
            out = [r["attname"] if isinstance(r, dict) else r[0] for r in cursor.fetchall()]
            cursor.execute("RELEASE SAVEPOINT _rsync_pk_probe")
            return out
        except Exception:
            try:
                cursor.execute("ROLLBACK TO SAVEPOINT _rsync_pk_probe")
                cursor.execute("RELEASE SAVEPOINT _rsync_pk_probe")
            except Exception:
                pass
            return []

    def _merge_conflict_keys(self, cursor, table: str, columns: List[str],
                             key_fields: List[str]) -> List[str]:
        """Prefer the destination's existing PRIMARY KEY as the ON CONFLICT
        target when the incoming rows carry every PK column, so a re-run REPLACES
        rows on the real business key instead of INSERTing ids that collide with
        a stale PK from a prior run (Bug A: silent full-table drop on dest schema
        drift). Falls back to the requested key, then ``id``/first column."""
        requested = [k for k in (key_fields or []) if k in columns]
        fallback = requested or (["id"] if "id" in columns else ([columns[0]] if columns else []))
        try:
            schema, name = self._split_schema_table(table)
        except Exception:
            return fallback
        pk = self._dest_pk_columns(cursor, schema, name)
        if pk and all(c in columns for c in pk) and pk != requested:
            return pk
        return fallback

    def upsert_data(self, params: Dict = None) -> Dict[str, Any]:
        if self._is_sqlserver_dialect():
            return self._ss_upsert_data(params)
        """
        Upsert data into database (INSERT or UPDATE on conflict).
        Used by kafka-mcp-sink for CDC update events.
        
        Params:
            config: Database connection config
            table: Target table name
            data: List of records to upsert
            key_fields: Primary key columns for conflict detection
        """
        prepared = self.prepare_import_data(params)
        
        if not prepared.get('success', True):
            return prepared
        
        data = prepared.get('data', [])
        if not data:
            return {"success": True, "rows_upserted": 0}
        
        config = prepared['config']
        table = prepared.get('table')
        key_fields = (params or {}).get('key_fields') or (params or {}).get('primary_key_fields') or ['id']
        if isinstance(key_fields, str):
            key_fields = [key_fields]
        if not isinstance(key_fields, list) or len(key_fields) == 0:
            key_fields = ['id']
        
        if not table:
            return {"success": False, "error": "Target table not specified"}
        # PostgreSQL normalization is a no-op for other drivers. Pass params so a
        # bare table + per-pipeline namespace lands in the right schema.
        table = self._normalize_table_for_postgresql(config, table, params)
        # Fail-closed write-path SQLi guard: the fallback INSERT/MERGE/DELETE
        # branches (incl. the generic `else` _gf_quoted via _split_schema_table)
        # interpolate the raw, tenant-controlled `table`. Reject an unsafe
        # identifier before ANY raw {table} interpolation — one entry guard
        # covers every downstream branch.
        if self._safe_qualified_table(table) is None:
            return {"success": False, "error": f"Unsafe table identifier: {table!r}"}

        # MySQL-family: resolve the per-pipeline namespace (database) and build a
        # backtick-qualified target before the per-driver upsert below — mirrors
        # import_data and the hand-curated mysql connector. Only one driver is
        # active per connector, so rewriting `table` here is safe for all branches.
        _mod = (self.driver_pattern.get("module", "") or "").lower()
        if "mysql" in _mod or "pymysql" in _mod:
            _db, _name = self._split_mysql_db_table(config, table, params)
            if not _name or not self._is_safe_ident(_name):
                return {"success": False, "error": f"Unsafe or missing table identifier: {_name}"}
            if _db and not self._is_safe_ident(_db):
                return {"success": False, "error": f"Unsafe database identifier: {_db}"}
            table = f"`{_db}`.`{_name}`" if _db else f"`{_name}`"
        elif "psycopg2" in _mod or "postgres" in _mod:
            # Postgres: double-quote "schema"."table" so case-sensitive table names
            # match the case-preserved relation ensure_table() created (unquoted
            # folds to lowercase → write misses table → DLQ). Mirrors mysql above.
            _pg_schema, _pg_name = self._split_schema_table(table)
            if not self._is_safe_ident(_pg_schema) or not self._is_safe_ident(_pg_name):
                return {"success": False, "error": f"Unsafe destination identifier: {_pg_schema}.{_pg_name}"}
            table = f'"{_pg_schema}"."{_pg_name}"'

        conn = None
        try:
            conn = self._get_connection(config)
            pattern = self.driver_pattern

            # Handle NoSQL (MongoDB)
            if pattern.get("is_nosql"):
                return self._upsert_nosql(conn, config, table, data, key_fields)
            
            cursor = self._get_cursor(conn, as_dict=False)
            # Union keys across ALL rows, not just data[0]. Wide-format transforms
            # (json_flatten / array_expand) emit ragged rows — each record's flattened
            # key set differs — so deriving the column list from the first row alone
            # silently drops every column unique to later rows. All value binding uses
            # row.get(col), so absent keys bind to NULL.
            columns = []
            _seen_cols = set()
            for _row in data:
                if not isinstance(_row, dict):
                    continue
                for _k in _row.keys():
                    if _k not in _seen_cols:
                        _seen_cols.add(_k)
                        columns.append(_k)
            rows_upserted = 0
            driver_module = pattern.get("module", "")
            
            # Validate all column identifiers once before building any
            # statement so a row containing a bad identifier doesn't bypass
            # the safety gate via the unquoted-substring path below.
            for c in columns:
                if not self._is_safe_ident(c):
                    return {"success": False, "error": f"Unsafe column identifier: {c}"}
            for k in key_fields:
                if k and not self._is_safe_ident(k):
                    return {"success": False, "error": f"Unsafe key field identifier: {k}"}

            # Dest-PK-aware conflict key, resolved ONCE before the loop: prefer the
            # destination's real PRIMARY KEY over a surrogate that would collide
            # with a stale PK (Bug A: silent full-table drop on dest schema drift).
            # One catalog lookup, not one per row.
            perrow_conflict_keys = self._merge_conflict_keys(cursor, table, columns, key_fields)
            for row in data:
                if "psycopg2" in driver_module or "asyncpg" in driver_module:
                    # PostgreSQL: INSERT ... ON CONFLICT DO UPDATE.
                    # Quote every identifier so camelCase columns survive
                    # Postgres' default lowercase-folding for unquoted names.
                    col_str = ", ".join([f'"{c}"' for c in columns])
                    placeholders = ", ".join(["%s"] * len(columns))
                    conflict_cols_list = perrow_conflict_keys
                    conflict_cols = ", ".join([f'"{c}"' for c in conflict_cols_list])
                    update_cols = [c for c in columns if c not in conflict_cols_list]

                    if update_cols:
                        update_str = ", ".join([f'"{c}" = EXCLUDED."{c}"' for c in update_cols])
                        query = f"INSERT INTO {table} ({col_str}) VALUES ({placeholders}) ON CONFLICT ({conflict_cols}) DO UPDATE SET {update_str}"
                    else:
                        query = f"INSERT INTO {table} ({col_str}) VALUES ({placeholders}) ON CONFLICT ({conflict_cols}) DO NOTHING"
                    
                    values = tuple(row.get(col) for col in columns)
                    try:
                        cursor.execute(query, values)
                    except Exception as e:
                        # CDC streaming-only may target tables that don't exist yet.
                        # If this is a CDC write (kafka-mcp-sink sets cdc_metadata), try to auto-create and retry once.
                        msg = str(e)
                        is_cdc = isinstance(params, dict) and ("cdc_metadata" in params or "source_table" in params or "operation" in params)
                        if is_cdc and ("does not exist" in msg.lower() or "undefinedtable" in msg.lower()):
                            try:
                                conn.rollback()
                            except Exception:
                                pass
                            cursor = self._get_cursor(conn, as_dict=False)
                            # Forward CDC sink's column types so the on-the-fly table is
                            # typed, not all-TEXT (CAPABILITIES.md KI-CDC-TYPE-RACE).
                            _ct = (params or {}).get("column_types") or (params or {}).get("columnTypes") or {}
                            self._ensure_table_for_cdc(cursor, table, columns, conflict_cols_list, _ct)
                            conn.commit()
                            cursor.execute(query, values)
                        else:
                            raise
                
                elif "mysql" in driver_module or "pymysql" in driver_module:
                    # MySQL: INSERT ... ON DUPLICATE KEY UPDATE
                    col_str = ", ".join(columns)
                    placeholders = ", ".join(["%s"] * len(columns))
                    update_cols = [c for c in columns if c not in key_fields]
                    
                    if update_cols:
                        update_str = ", ".join([f"{c} = VALUES({c})" for c in update_cols])
                        query = f"INSERT INTO {table} ({col_str}) VALUES ({placeholders}) ON DUPLICATE KEY UPDATE {update_str}"
                    else:
                        # All columns are keys -> no-op self-update rather than INSERT
                        # IGNORE: IGNORE downgrades truncation/coercion to a warning even
                        # under strict sql_mode (silent corruption); a no-op ON DUPLICATE
                        # keeps dedup semantics while letting strict mode RAISE on data loss.
                        _noop = key_fields[0]
                        query = f"INSERT INTO {table} ({col_str}) VALUES ({placeholders}) ON DUPLICATE KEY UPDATE {_noop} = {_noop}"
                    
                    values = tuple(row.get(col) for col in columns)
                    cursor.execute(query, values)
                
                elif "oracledb" in driver_module or "cx_Oracle" in driver_module:
                    # Oracle: MERGE statement
                    col_str = ", ".join(columns)
                    src_cols = ", ".join([f":{i+1} AS {c}" for i, c in enumerate(columns)])
                    match_cond = " AND ".join([f"t.{k} = s.{k}" for k in key_fields])
                    update_cols = [c for c in columns if c not in key_fields]
                    
                    if update_cols:
                        update_str = ", ".join([f"t.{c} = s.{c}" for c in update_cols])
                        insert_cols = ", ".join([f"s.{c}" for c in columns])
                        query = f"""
                            MERGE INTO {table} t
                            USING (SELECT {src_cols} FROM dual) s
                            ON ({match_cond})
                            WHEN MATCHED THEN UPDATE SET {update_str}
                            WHEN NOT MATCHED THEN INSERT ({col_str}) VALUES ({insert_cols})
                        """
                    else:
                        insert_cols = ", ".join([f"s.{c}" for c in columns])
                        query = f"""
                            MERGE INTO {table} t
                            USING (SELECT {src_cols} FROM dual) s
                            ON ({match_cond})
                            WHEN NOT MATCHED THEN INSERT ({col_str}) VALUES ({insert_cols})
                        """
                    
                    values = tuple(row.get(col) for col in columns)
                    cursor.execute(query, values)
                
                else:
                    # Generic fallback: DELETE + INSERT
                    # Quote table identifiers (ANSI SQL double-quotes) so reserved words
                    # and camelCase names survive without errors.
                    _gf_schema, _gf_name = self._split_schema_table(table)
                    _gf_quoted = f'"{_gf_schema}"."{_gf_name}"'
                    where_clause = " AND ".join([f"{k} = %s" for k in key_fields])
                    key_values = tuple(row.get(k) for k in key_fields)
                    cursor.execute(f"DELETE FROM {_gf_quoted} WHERE {where_clause}", key_values)

                    col_str = ", ".join(columns)
                    placeholders = ", ".join(["%s"] * len(columns))
                    values = tuple(row.get(col) for col in columns)
                    cursor.execute(f"INSERT INTO {_gf_quoted} ({col_str}) VALUES ({placeholders})", values)
                
                rows_upserted += 1

            # Record the Kafka high-water offset in the SAME transaction as the
            # batch so data + progress are atomic (replaces Redis dedup).
            self._write_cdc_offsets(cursor, params)
            conn.commit()
            cursor.close()
            return {"success": True, "rows_upserted": rows_upserted}
        
        except Exception as e:
            if conn:
                try:
                    conn.rollback()
                except:
                    pass
            return {"success": False, "error": str(e)}
        finally:
            if conn:
                try:
                    conn.close()
                except:
                    pass
    
    def delete_data(self, params: Dict = None) -> Dict[str, Any]:
        if self._is_sqlserver_dialect():
            return self._ss_delete_data(params)
        """
        Delete data from database by primary key.
        Used by kafka-mcp-sink for CDC delete events.
        
        Params:
            config: Database connection config
            table: Target table name
            data: List of records containing key fields
            key_fields: Primary key columns
        """
        params = params or {}

        # Normalize common CDC delete shapes: some producers send the PK in `key_data`,
        # or embed the pre-image under `before` (Debezium).
        normalized = params
        if isinstance(normalized, dict):
            d = normalized.get("data")
            if d is None:
                for k in ("key_data", "before", "key", "kafka_key", "record_key", "primary_key", "keys"):
                    if isinstance(normalized.get(k), dict):
                        normalized = {**normalized, "data": [normalized.get(k)]}
                        break
                if normalized.get("data") is None and isinstance(normalized.get("keys"), list):
                    normalized = {**normalized, "data": normalized.get("keys")}
            elif isinstance(d, dict):
                normalized = {**normalized, "data": [d]}

        prepared = self.prepare_import_data(normalized)
        if not prepared.get('success', True):
            return prepared

        config = prepared.get('config') or {}
        table = prepared.get('table')
        data = prepared.get('data', []) or []

        key_fields = params.get('key_fields') or params.get('primary_key_fields') or config.get('key_fields') or ['id']
        if isinstance(key_fields, str):
            key_fields = [key_fields]
        if not isinstance(key_fields, list) or len(key_fields) == 0:
            key_fields = ['id']
        
        if not table:
            return {"success": False, "error": "Target table not specified"}
        # PostgreSQL normalization is a no-op for other drivers. Pass params so a
        # bare table + per-pipeline namespace resolves to the same schema the
        # insert/upsert path wrote to — otherwise CDC deletes target public and
        # silently no-op while the namespaced rows survive.
        table = self._normalize_table_for_postgresql(config, table, params)
        # Fail-closed write-path SQLi guard: the generic `else` DELETE branch
        # builds _del_quoted via _split_schema_table WITHOUT validation, so the
        # raw, tenant-controlled `table` reaches the DELETE. Reject an unsafe
        # identifier before ANY raw {table} interpolation.
        if self._safe_qualified_table(table) is None:
            return {"success": False, "error": f"Unsafe table identifier: {table!r}"}

        if not data:
            return {"success": True, "rows_deleted": 0}
        
        conn = None
        try:
            conn = self._get_connection(config)
            pattern = self.driver_pattern
            
            if pattern.get("is_nosql"):
                return self._delete_nosql(conn, config, table, data, key_fields)
            
            cursor = self._get_cursor(conn, as_dict=False)
            rows_deleted = 0

            # Build the quoted delete target per driver. MySQL: the database is the
            # namespace — resolve it via _split_mysql_db_table (the executor forwards
            # a BARE table + the per-pipeline namespace separately) and backtick-quote,
            # mirroring import_data/upsert_data; without this a bare table defaults to
            # the connection DB and the namespaced delete silently no-ops. PG/other:
            # ANSI double-quotes; `table` is already namespace-normalized above, so a
            # schema split yields the right schema-qualified target.
            _del_mod = (self.driver_pattern.get("module", "") or "").lower()
            if "mysql" in _del_mod or "pymysql" in _del_mod:
                _del_db, _del_name = self._split_mysql_db_table(config, table, params)
                if not _del_name or not self._is_safe_ident(_del_name):
                    return {"success": False, "error": f"Unsafe or missing table identifier: {_del_name}"}
                if _del_db and not self._is_safe_ident(_del_db):
                    return {"success": False, "error": f"Unsafe database identifier: {_del_db}"}
                _del_quoted = f"`{_del_db}`.`{_del_name}`" if _del_db else f"`{_del_name}`"
            else:
                _del_schema, _del_name = self._split_schema_table(table)
                _del_quoted = f'"{_del_schema}"."{_del_name}"'

            for row in data:
                where_clause = " AND ".join([f"{k} = %s" for k in key_fields])
                missing = [k for k in key_fields if k not in row]
                if missing:
                    return {"success": False, "error": f"Missing required key field(s) for delete: {missing}"}
                key_values = tuple(row.get(k) for k in key_fields)
                if any(v is None for v in key_values):
                    return {"success": False, "error": f"Delete key field(s) contain null value(s): {key_fields}"}

                cursor.execute(f"DELETE FROM {_del_quoted} WHERE {where_clause}", key_values)
                rows_deleted += cursor.rowcount if hasattr(cursor, 'rowcount') else 1

            # Record the Kafka high-water offset in the SAME transaction as the
            # delete so data + progress stay atomic (replaces Redis dedup).
            self._write_cdc_offsets(cursor, params)
            conn.commit()
            cursor.close()
            return {"success": True, "rows_deleted": rows_deleted}
        
        except Exception as e:
            if conn:
                try:
                    conn.rollback()
                except:
                    pass
            return {"success": False, "error": str(e)}
        finally:
            if conn:
                try:
                    conn.close()
                except:
                    pass
    
    # ------------------------------------------------------------------
    # CDC exactly-once offset tracking (Tier A: transactional).
    # The destination offset table is the sole durable source of truth for
    # per-partition Kafka progress, replacing Redis dedup. Offsets are written
    # in the SAME transaction as the data batch so they cannot diverge.
    # ------------------------------------------------------------------
    _CDC_OFFSETS_TABLE = "_rsync_cdc_offsets"

    def _write_cdc_offsets(self, cursor, params) -> None:
        """Persist Kafka high-water offsets inside the caller's open transaction.
        No-op unless the caller (kafka-mcp-sink) supplied ``kafka_offset``.
        Monotonic: an offset is only advanced, never moved backwards."""
        ko = (params or {}).get("kafka_offset")
        if not ko:
            return
        offsets = ko if isinstance(ko, list) else [ko]
        module = self.driver_pattern.get("module", "") if hasattr(self, "driver_pattern") else ""
        tbl = self._CDC_OFFSETS_TABLE
        upsert = None
        ph = "pg"  # "pg" => %s placeholders, "oracle" => :N placeholders
        if "psycopg2" in module or "asyncpg" in module:
            cursor.execute(
                f'CREATE TABLE IF NOT EXISTS "{tbl}" ('
                ' pipeline_id TEXT NOT NULL, topic TEXT NOT NULL,'
                ' kafka_partition INTEGER NOT NULL, last_offset BIGINT NOT NULL,'
                ' updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),'
                ' PRIMARY KEY (pipeline_id, topic, kafka_partition))')
            upsert = (
                f'INSERT INTO "{tbl}" (pipeline_id, topic, kafka_partition, last_offset, updated_at)'
                ' VALUES (%s, %s, %s, %s, now())'
                ' ON CONFLICT (pipeline_id, topic, kafka_partition) DO UPDATE SET'
                f'  last_offset = GREATEST("{tbl}".last_offset, EXCLUDED.last_offset), updated_at = now()')
        elif "mysql" in module or "pymysql" in module:
            cursor.execute(
                f'CREATE TABLE IF NOT EXISTS `{tbl}` ('
                ' pipeline_id VARCHAR(255) NOT NULL, topic VARCHAR(255) NOT NULL,'
                ' kafka_partition INT NOT NULL, last_offset BIGINT NOT NULL,'
                ' updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,'
                ' PRIMARY KEY (pipeline_id, topic, kafka_partition)) ENGINE=InnoDB')
            upsert = (
                f'INSERT INTO `{tbl}` (pipeline_id, topic, kafka_partition, last_offset)'
                ' VALUES (%s, %s, %s, %s)'
                ' ON DUPLICATE KEY UPDATE last_offset = GREATEST(last_offset, VALUES(last_offset))')
        elif "oracledb" in module or "cx_Oracle" in module:
            ph = "oracle"
            try:
                cursor.execute(
                    f'CREATE TABLE "{tbl}" ('
                    ' pipeline_id VARCHAR2(255) NOT NULL, topic VARCHAR2(255) NOT NULL,'
                    ' kafka_partition NUMBER(10) NOT NULL, last_offset NUMBER(19) NOT NULL,'
                    ' updated_at TIMESTAMP DEFAULT SYSTIMESTAMP,'
                    f' CONSTRAINT pk_rsync_cdc_off PRIMARY KEY (pipeline_id, topic, kafka_partition))')
            except Exception:
                pass  # table already exists
            upsert = (
                f'MERGE INTO "{tbl}" t USING ('
                ' SELECT :1 pipeline_id, :2 topic, :3 kafka_partition, :4 last_offset FROM dual) s'
                ' ON (t.pipeline_id = s.pipeline_id AND t.topic = s.topic'
                '     AND t.kafka_partition = s.kafka_partition)'
                ' WHEN MATCHED THEN UPDATE SET'
                ' t.last_offset = GREATEST(t.last_offset, s.last_offset), t.updated_at = SYSTIMESTAMP'
                ' WHEN NOT MATCHED THEN INSERT (pipeline_id, topic, kafka_partition, last_offset)'
                ' VALUES (s.pipeline_id, s.topic, s.kafka_partition, s.last_offset)')
        else:
            # Generic ANSI fallback: emulate a monotonic upsert with DELETE+INSERT.
            cursor.execute(
                f'CREATE TABLE IF NOT EXISTS "{tbl}" ('
                ' pipeline_id VARCHAR(255) NOT NULL, topic VARCHAR(255) NOT NULL,'
                ' kafka_partition INTEGER NOT NULL, last_offset BIGINT NOT NULL,'
                ' PRIMARY KEY (pipeline_id, topic, kafka_partition))')

        for o in offsets:
            if not isinstance(o, dict):
                continue
            pid = str(o.get("pipeline_id") or "")
            topic = o.get("topic") or ""
            part = o.get("partition")
            off = o.get("offset")
            if not topic or part is None or off is None:
                continue
            vals = (pid, str(topic), int(part), int(off))
            if upsert is not None:
                cursor.execute(upsert, vals)
            else:
                # Generic: only insert/replace when advancing the high-water mark.
                cursor.execute(
                    f'DELETE FROM "{tbl}" WHERE pipeline_id = %s AND topic = %s'
                    ' AND kafka_partition = %s AND last_offset <= %s', vals)
                try:
                    cursor.execute(
                        f'INSERT INTO "{tbl}" (pipeline_id, topic, kafka_partition, last_offset)'
                        ' VALUES (%s, %s, %s, %s)', vals)
                except Exception:
                    pass  # a concurrent/ahead row already holds a higher offset

    # SQL Server (pyodbc) DESTINATION write path.
    #
    # The base render of this connector is MySQL-shaped (backtick quoting,
    # %s params, ON DUPLICATE KEY UPDATE, CREATE DATABASE-per-namespace,
    # information_schema.statistics) — none of which is valid on SQL Server /
    # Azure SQL. So the destination entrypoints (ensure_schema / ensure_table /
    # drop_table / import_data / upsert_data / delete_data / get_cdc_offsets)
    # dispatch here when the driver is pyodbc. Design mirrors the PostgreSQL
    # connector: the per-pipeline namespace maps to a SCHEMA in the connected
    # database (NOT a separate database — Azure SQL cannot CREATE DATABASE on
    # demand and forbids cross-DB references), defaulting to ``dbo``. Dialect:
    # [bracket] quoting, ? placeholders, MERGE upsert, sys.* catalog probes,
    # NVARCHAR(MAX) storage columns (bounded NVARCHAR on indexed key columns to
    # respect SQL Server's 900-byte index-key limit), DATETIME2 / BIT / BIGINT.
    # ==================================================================
    def _is_sqlserver_dialect(self) -> bool:
        try:
            return "pyodbc" in (self.driver_pattern.get("module") or "")
        except Exception:
            return False

    @staticmethod
    def _ss_quote(ident: str) -> str:
        """Bracket-quote a SQL Server identifier ( ] -> ]] )."""
        return "[" + str(ident).replace("]", "]]") + "]"

    def _ss_col_type(self, canonical: Optional[str], is_key: bool = False, single_key: bool = True) -> str:
        """Map a canonical type to a SQL Server column type.

        Non-key text columns are NVARCHAR(MAX); indexed key columns are bounded
        (NVARCHAR(450) lone key / NVARCHAR(200) composite) so the unique index
        stays within SQL Server's 900-byte key limit.
        """
        # Delegated to the shared canonical->DDL authority (fixes exact decimal
        # -> DECIMAL(p,s), previously the lossy FLOAT; canonical `number` stays
        # FLOAT). Batch path only; inputs are canonical.
        return canonical_to_ddl("sqlserver", canonical, is_key=is_key, single_key=single_key)

    def _split_sqlserver_schema_table(self, config: Dict, table: str, params: Dict = None):
        """Resolve (schema, bare_table). The namespace maps to a SCHEMA in the
        connected DB, defaulting to ``dbo`` (Azure SQL can't CREATE DATABASE on
        demand). Precedence: qualified schema.table > per-pipeline namespace > dbo.
        """
        raw = str(table or "").strip().strip("[").strip("]").strip('"').strip("`")
        if "." in raw:
            schema = raw.split(".", 1)[0].strip("[").strip("]").strip('"').strip("`")
            name = raw.split(".", 1)[1].strip("[").strip("]").strip('"').strip("`")
            prefix = schema + "."
            while name.lower().startswith(prefix.lower()) and len(name) > len(prefix):
                name = name[len(prefix):]
            return schema, name
        if params:
            ns = str(
                params.get("namespace")
                or params.get("db_or_schema")
                or params.get("schema")
                or ""
            ).strip().strip("[").strip("]").strip('"').strip("`")
            if ns and ns.lower() != "default" and self._is_safe_ident(ns):
                return ns, raw
        return "dbo", raw

    def _ss_ensure_schema_exists(self, cursor, schema: str) -> None:
        """CREATE SCHEMA if absent (dynamic SQL — CREATE SCHEMA must lead a batch)."""
        if not schema or not self._is_safe_ident(schema):
            raise Exception(f"Unsafe schema identifier: {schema}")
        if schema.lower() == "dbo":
            return  # dbo always exists
        cursor.execute(
            "IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = ?) "
            f"EXEC('CREATE SCHEMA {self._ss_quote(schema)}')",
            (schema,),
        )

    def _ss_ensure_table_ddl(self, cursor, config, table, columns, key_fields, column_types, params):
        """Create/evolve the destination schema + table; returns (schema, name)."""
        schema, name = self._split_sqlserver_schema_table(config, table, params)
        if not schema or not self._is_safe_ident(schema) or not self._is_safe_ident(name):
            raise Exception(f"Unsafe or missing schema/table identifier: {schema}.{name}")
        safe_cols = [c for c in (columns or []) if self._is_safe_ident(c)]
        if not safe_cols:
            raise Exception("No safe columns to create destination table")
        safe_keys = [c for c in (key_fields or []) if self._is_safe_ident(c) and c in safe_cols]
        key_set = set(safe_keys)
        single_key = len(safe_keys) <= 1
        ctypes = column_types if isinstance(column_types, dict) else {}

        self._ss_ensure_schema_exists(cursor, schema)

        qname = f"{self._ss_quote(schema)}.{self._ss_quote(name)}"
        obj = f"{schema}.{name}"
        col_defs = ", ".join(
            f"{self._ss_quote(c)} {self._ss_col_type(ctypes.get(c), c in key_set, single_key)}"
            for c in safe_cols
        )
        cursor.execute(f"IF OBJECT_ID(N'{obj}', N'U') IS NULL CREATE TABLE {qname} ({col_defs})")

        # Add columns absent from a pre-existing table (schema evolution).
        cursor.execute("SELECT c.name FROM sys.columns c WHERE c.object_id = OBJECT_ID(?)", (obj,))
        existing = set()
        for r in cursor.fetchall() or []:
            v = r.get("name") if isinstance(r, dict) else (r[0] if r else None)
            if v:
                existing.add(str(v))
        for c in safe_cols:
            if c not in existing:
                cursor.execute(
                    f"ALTER TABLE {qname} ADD {self._ss_quote(c)} "
                    f"{self._ss_col_type(ctypes.get(c), c in key_set, single_key)}"
                )

        # Unique index backing the MERGE key (idempotent upserts).
        if safe_keys:
            idx = self._mk_index_name(schema, name, safe_keys)
            cursor.execute(
                "SELECT 1 FROM sys.indexes WHERE name = ? AND object_id = OBJECT_ID(?)",
                (idx, obj),
            )
            if not cursor.fetchone():
                cols_sql = ", ".join(self._ss_quote(c) for c in safe_keys)
                cursor.execute(f"CREATE UNIQUE INDEX {self._ss_quote(idx)} ON {qname} ({cols_sql})")
        return schema, name

    def _ss_introspect_dest_column_types(self, config: Dict, table: str, schema: str) -> Optional[Dict[str, str]]:
        """Read dest column types → canonical hints (timestamp/boolean) for binding."""
        bare = str(table or "").strip().strip("[").strip("]").strip('"').strip("`")
        if "." in bare:
            bare = bare.split(".", 1)[1].strip("[").strip("]").strip('"').strip("`")
        schema = str(schema or "dbo").strip().strip("[").strip("]").strip('"').strip("`") or "dbo"
        conn = None
        try:
            conn = self._get_connection(config)
            cursor = self._get_cursor(conn, as_dict=False)
            cursor.execute(
                "SELECT COLUMN_NAME, DATA_TYPE FROM INFORMATION_SCHEMA.COLUMNS "
                "WHERE TABLE_SCHEMA = ? AND TABLE_NAME = ?",
                (schema, bare),
            )
            out: Dict[str, str] = {}
            for row in cursor.fetchall() or []:
                cname, dtype = row[0], (row[1] or "").lower()
                if dtype in ("datetime2", "datetime", "smalldatetime", "date", "time"):
                    out[cname] = "timestamp"
                elif dtype == "bit":
                    out[cname] = "boolean"
            cursor.close()
            return out
        except Exception:
            return None
        finally:
            if conn is not None:
                try:
                    conn.close()
                except Exception:
                    pass

    def _ss_write_cdc_offsets(self, cursor, params) -> None:
        """Persist Kafka high-water offsets in the current (uncommitted) txn.

        Fixed location dbo._rsync_cdc_offsets (namespace-independent so write and
        get_cdc_offsets agree). Keyed on (pipeline_id, topic, kafka_partition);
        MERGE keeps the max offset. No-op when kafka_offset is absent (plain batch).
        """
        ko = (params or {}).get("kafka_offset")
        if not ko:
            return
        offsets = ko if isinstance(ko, list) else [ko]
        otbl = "[dbo].[_rsync_cdc_offsets]"
        cursor.execute(
            "IF OBJECT_ID(N'dbo._rsync_cdc_offsets', N'U') IS NULL "
            f"CREATE TABLE {otbl} ("
            "pipeline_id NVARCHAR(128) NOT NULL, topic NVARCHAR(255) NOT NULL, "
            "kafka_partition INT NOT NULL, last_offset BIGINT NOT NULL, "
            "updated_at DATETIME2 NOT NULL DEFAULT SYSUTCDATETIME(), "
            "CONSTRAINT [pk_rsync_cdc_offsets] PRIMARY KEY (pipeline_id, topic, kafka_partition))"
        )
        merge = (
            f"MERGE {otbl} AS t USING (VALUES (?, ?, ?, ?)) AS s "
            "(pipeline_id, topic, kafka_partition, last_offset) "
            "ON t.pipeline_id = s.pipeline_id AND t.topic = s.topic "
            "AND t.kafka_partition = s.kafka_partition "
            "WHEN MATCHED THEN UPDATE SET "
            "last_offset = CASE WHEN s.last_offset > t.last_offset THEN s.last_offset ELSE t.last_offset END, "
            "updated_at = SYSUTCDATETIME() "
            "WHEN NOT MATCHED THEN INSERT (pipeline_id, topic, kafka_partition, last_offset) "
            "VALUES (s.pipeline_id, s.topic, s.kafka_partition, s.last_offset);"
        )
        for o in offsets:
            if not isinstance(o, dict):
                continue
            pid = o.get("pipeline_id") or ""
            topic = o.get("topic") or ""
            part = o.get("partition")
            off = o.get("offset")
            if not topic or part is None or off is None:
                continue
            cursor.execute(merge, (str(pid)[:128], str(topic)[:255], int(part), int(off)))

    def _ss_get_cdc_offsets(self, params: Dict = None) -> Dict[str, Any]:
        """SQL Server variant of get_cdc_offsets (reads dbo._rsync_cdc_offsets)."""
        conn = None
        try:
            config = self._get_config(params) if hasattr(self, "_get_config") else ((params or {}).get("config") or {})
            pipeline_id = (params or {}).get("pipeline_id") or ""
            conn = self._get_connection(config)
            cursor = self._get_cursor(conn, as_dict=False)
            try:
                cursor.execute(
                    "SELECT topic, kafka_partition, last_offset FROM [dbo].[_rsync_cdc_offsets] "
                    "WHERE pipeline_id = ?",
                    (str(pipeline_id),),
                )
                rows = cursor.fetchall()
            except Exception:
                # Table absent / not provisioned yet → no offsets recorded.
                try:
                    conn.rollback()
                except Exception:
                    pass
                return {"success": True, "offsets": []}
            finally:
                cursor.close()
            offsets = [
                {"topic": r[0], "partition": int(r[1]), "offset": int(r[2])}
                for r in (rows or [])
            ]
            return {"success": True, "offsets": offsets}
        except Exception as e:
            return {"success": False, "error": str(e)}
        finally:
            if conn:
                try:
                    conn.close()
                except Exception:
                    pass

    def _ss_ensure_schema(self, params: Dict = None) -> Dict[str, Any]:
        """SQL Server variant of ensure_schema: CREATE SCHEMA (not CREATE DATABASE)."""
        if not bool(getattr(self, "supports_ddl", False)):
            return {"success": False, "error": "DDL helpers not supported by this connector"}
        params = params or {}
        config = self._get_config(params)
        schema = str(params.get("schema") or "").strip().strip("[").strip("]").strip('"').strip("`")
        if not schema:
            return {"success": False, "error": "Missing schema"}
        if not self._is_safe_ident(schema):
            return {"success": False, "error": f"Unsafe schema identifier: {schema}"}
        conn = None
        cursor = None
        try:
            conn = self._get_connection(config)
            cursor = self._get_cursor(conn, as_dict=False)
            self._ss_ensure_schema_exists(cursor, schema)
            try:
                conn.commit()
            except Exception:
                pass
            return {"success": True, "schema": schema, "database": config.get("database")}
        except Exception as e:
            if conn:
                try:
                    conn.rollback()
                except Exception:
                    pass
            return {"success": False, "error": str(e)}
        finally:
            try:
                if cursor is not None:
                    cursor.close()
            except Exception:
                pass
            try:
                if conn is not None:
                    conn.close()
            except Exception:
                pass

    def _ss_ensure_table(self, params: Dict = None) -> Dict[str, Any]:
        """SQL Server variant of ensure_table (schema + table + unique key index)."""
        if not bool(getattr(self, "supports_ddl", False)):
            return {"success": False, "error": "DDL helpers not supported by this connector"}
        params = params or {}
        config = self._get_config(params)
        table = str(params.get("table") or "").strip()
        if not table:
            return {"success": False, "error": "Missing table"}

        cols_raw = params.get("columns") or []
        columns: List[str] = []
        if isinstance(cols_raw, list):
            for c in cols_raw:
                cc = str(c or "").strip()
                if cc:
                    columns.append(cc)

        keys_raw = params.get("key_fields") or params.get("keys") or []
        key_fields: List[str] = []
        if isinstance(keys_raw, list):
            for c in keys_raw:
                cc = str(c or "").strip()
                if cc:
                    key_fields.append(cc)

        col_types_raw = params.get("column_types") or {}
        column_types: Dict[str, str] = {}
        if isinstance(col_types_raw, dict):
            for k, v in col_types_raw.items():
                if k and v:
                    column_types[str(k)] = str(v)

        # Synthetic-PK fallback (Fivetran-style), identical policy to the MySQL
        # path: append-only history (synthetic_pk=false / append_mode=true) is a
        # hard opt-out; otherwise a missing PK injects _rsync_row_hash + _synced_at.
        _append_mode = bool(params.get("append_mode"))
        _synthetic_pk_param = params.get("synthetic_pk")
        _synthetic_pk_disabled = (_synthetic_pk_param is False) or _append_mode
        synthetic_pk_requested = (
            bool(_synthetic_pk_param) or (not key_fields)
        ) and not _synthetic_pk_disabled
        synthetic_pk_applied = False
        if synthetic_pk_requested and not key_fields:
            if SYNTHETIC_PK_COL not in columns:
                columns.append(SYNTHETIC_PK_COL)
            if SYNTHETIC_TS_COL not in columns:
                columns.append(SYNTHETIC_TS_COL)
            column_types.setdefault(SYNTHETIC_PK_COL, "string")
            column_types.setdefault(SYNTHETIC_TS_COL, "timestamp")
            key_fields = [SYNTHETIC_PK_COL]
            synthetic_pk_applied = True

        conn = None
        cursor = None
        try:
            conn = self._get_connection(config)
            cursor = self._get_cursor(conn, as_dict=False)
            self._ss_ensure_table_ddl(cursor, config, table, columns, key_fields, column_types, params)
            try:
                conn.commit()
            except Exception:
                pass
            return {
                "success": True,
                "table": table,
                "synthetic_pk": synthetic_pk_applied,
                "key_fields": key_fields,
            }
        except Exception as e:
            if conn:
                try:
                    conn.rollback()
                except Exception:
                    pass
            return {"success": False, "error": str(e)}
        finally:
            try:
                if cursor is not None:
                    cursor.close()
            except Exception:
                pass
            try:
                if conn is not None:
                    conn.close()
            except Exception:
                pass

    def _ss_drop_table(self, params: Dict = None) -> Dict[str, Any]:
        """SQL Server variant of drop_table (reload semantics). Plain DROP;
        missing table is a success no-op."""
        if not bool(getattr(self, "supports_ddl", False)):
            return {"success": False, "error": "DDL helpers not supported by this connector"}
        params = params or {}
        config = self._get_config(params)
        table = str(params.get("table") or "").strip()
        if not table:
            return {"success": False, "error": "Missing table"}
        schema, name = self._split_sqlserver_schema_table(config, table, params)
        if not schema or not self._is_safe_ident(schema) or not self._is_safe_ident(name):
            return {"success": False, "error": f"Unsafe or missing schema/table identifier: {schema}.{name}"}
        conn = None
        cursor = None
        try:
            conn = self._get_connection(config)
            cursor = self._get_cursor(conn, as_dict=False)
            obj = f"{schema}.{name}"
            cursor.execute("SELECT 1 FROM sys.objects WHERE object_id = OBJECT_ID(?) AND type = 'U'", (obj,))
            if not cursor.fetchone():
                try:
                    conn.commit()
                except Exception:
                    pass
                return {"success": True, "table": table, "dropped": False, "message": "table does not exist"}
            qname = f"{self._ss_quote(schema)}.{self._ss_quote(name)}"
            cursor.execute(f"DROP TABLE {qname}")
            try:
                conn.commit()
            except Exception:
                pass
            return {"success": True, "table": table, "dropped": True}
        except Exception as e:
            if conn:
                try:
                    conn.rollback()
                except Exception:
                    pass
            return {"success": False, "error": str(e)}
        finally:
            try:
                if cursor is not None:
                    cursor.close()
            except Exception:
                pass
            try:
                if conn is not None:
                    conn.close()
            except Exception:
                pass

    def _ss_import_data(self, params: Dict = None) -> Dict[str, Any]:
        """SQL Server batch INSERT (append). Auto-creates the table on first write."""
        prepared = self.prepare_import_data(params)
        if not prepared.get("success", True):
            return prepared
        data = prepared.get("data", [])
        if not data:
            return {"success": True, "rows_inserted": 0, "message": "No data to import"}
        config = prepared["config"]
        table = prepared.get("table")
        if not table:
            return {"success": False, "error": "Target table not specified"}
        schema, name = self._split_sqlserver_schema_table(config, table, params)
        if not name or not self._is_safe_ident(name):
            return {"success": False, "error": f"Unsafe or missing table identifier: {name}"}
        if schema and not self._is_safe_ident(schema):
            return {"success": False, "error": f"Unsafe schema identifier: {schema}"}
        qname = f"{self._ss_quote(schema)}.{self._ss_quote(name)}"

        conn = None
        try:
            conn = self._get_connection(config)
            cursor = self._get_cursor(conn, as_dict=False)

            columns: List[str] = []
            _seen = set()
            for _row in data:
                if not isinstance(_row, dict):
                    continue
                for _k in _row.keys():
                    if _k not in _seen:
                        _seen.add(_k)
                        columns.append(_k)
            safe_columns = [c for c in columns if self._is_safe_ident(c)]
            if not safe_columns:
                return {"success": False, "error": "No safe columns to import"}
            placeholders = ", ".join(["?"] * len(safe_columns))
            col_str = ", ".join(self._ss_quote(c) for c in safe_columns)
            insert_query = f"INSERT INTO {qname} ({col_str}) VALUES ({placeholders})"

            col_types = (params or {}).get("column_types") or {}
            if not isinstance(col_types, dict):
                col_types = {}
            if not col_types:
                col_types = self._ss_introspect_dest_column_types(config, name, schema) or {}

            def _rows(batch):
                return [
                    tuple(_mysql_bind_value(row.get(col), col_types.get(col)) for col in safe_columns)
                    for row in batch
                ]

            rows_inserted = 0
            batch_size = min(self.max_batch_size, 1000)
            for i in range(0, len(data), batch_size):
                batch = data[i:i + batch_size]
                values = _rows(batch)
                try:
                    cursor.executemany(insert_query, values)
                except Exception as e:
                    if "invalid object name" in str(e).lower():
                        try:
                            conn.rollback()
                        except Exception:
                            pass
                        cursor = self._get_cursor(conn, as_dict=False)
                        self._ss_ensure_table_ddl(cursor, config, name, safe_columns, [], col_types, params)
                        conn.commit()
                        cursor.executemany(insert_query, values)
                    else:
                        raise
                affected = cursor.rowcount
                rows_inserted += affected if (affected is not None and affected >= 0) else len(batch)

            logger.info("import_data[sqlserver]: target=%s.%s submitted=%d affected=%d",
                        schema, name, len(data), rows_inserted)
            self._ss_write_cdc_offsets(cursor, params)
            conn.commit()
            cursor.close()
            return {"success": True, "rows_inserted": rows_inserted}
        except Exception as e:
            if conn:
                try:
                    conn.rollback()
                except Exception:
                    pass
            return {"success": False, "error": str(e)}
        finally:
            if conn:
                try:
                    conn.close()
                except Exception:
                    pass

    def _ss_upsert_data(self, params: Dict = None) -> Dict[str, Any]:
        """SQL Server CDC upsert via per-row MERGE (idempotent on the key index)."""
        params = params or {}
        prepared = self.prepare_import_data(params)
        if not prepared.get("success", True):
            return prepared
        data = prepared.get("data", [])
        if not data:
            return {"success": True, "rows_upserted": 0, "message": "No data to upsert"}
        config = prepared["config"]
        table = prepared.get("table")
        if not table:
            return {"success": False, "error": "Target table not specified"}
        schema, name = self._split_sqlserver_schema_table(config, table, params)
        if not name or not self._is_safe_ident(name):
            return {"success": False, "error": f"Unsafe or missing table identifier: {name}"}
        if schema and not self._is_safe_ident(schema):
            return {"success": False, "error": f"Unsafe schema identifier: {schema}"}
        qname = f"{self._ss_quote(schema)}.{self._ss_quote(name)}"

        key_fields = (
            params.get("key_fields")
            or params.get("primary_key_fields")
            or config.get("key_fields")
            or config.get("primary_key_fields")
            or ["id"]
        )
        if isinstance(key_fields, str):
            key_fields = [key_fields]
        if not isinstance(key_fields, list) or len(key_fields) == 0:
            key_fields = ["id"]

        col_types = params.get("column_types") or {}
        if not isinstance(col_types, dict):
            col_types = {}
        if not col_types:
            col_types = self._ss_introspect_dest_column_types(config, name, schema) or {}

        if bool(params.get("synthetic_pk")):
            from datetime import datetime, timezone
            now_str = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S.%f")
            source_cols = [c for c in data[0].keys() if not c.startswith("_rsync_")]
            for row in data:
                if SYNTHETIC_PK_COL not in row:
                    row[SYNTHETIC_PK_COL] = _compute_row_hash(row, source_cols)
                if SYNTHETIC_TS_COL not in row:
                    row[SYNTHETIC_TS_COL] = now_str
            key_fields = [SYNTHETIC_PK_COL]

        conn = None
        try:
            conn = self._get_connection(config)
            cursor = self._get_cursor(conn, as_dict=False)

            columns: List[str] = []
            _seen = set()
            for _row in data:
                if not isinstance(_row, dict):
                    continue
                for _k in _row.keys():
                    if _k not in _seen:
                        _seen.add(_k)
                        columns.append(_k)
            columns = [c for c in columns if self._is_safe_ident(c)]
            if not columns:
                return {"success": False, "error": "No safe columns to upsert"}

            conflict_cols = [k for k in key_fields if k in columns and self._is_safe_ident(k)]
            if not conflict_cols:
                conflict_cols = ["id"] if "id" in columns else [columns[0]]
            update_cols = [c for c in columns if c not in conflict_cols]

            placeholders = ", ".join(["?"] * len(columns))
            src_cols = ", ".join(self._ss_quote(c) for c in columns)
            on_clause = " AND ".join(f"tgt.{self._ss_quote(k)} = src.{self._ss_quote(k)}" for k in conflict_cols)
            if update_cols:
                set_clause = ", ".join(f"tgt.{self._ss_quote(c)} = src.{self._ss_quote(c)}" for c in update_cols)
                matched = f"WHEN MATCHED THEN UPDATE SET {set_clause} "
            else:
                matched = ""  # all columns are keys → insert-if-absent only
            insert_cols = ", ".join(self._ss_quote(c) for c in columns)
            insert_vals = ", ".join(f"src.{self._ss_quote(c)}" for c in columns)
            merge_query = (
                f"MERGE INTO {qname} AS tgt "
                f"USING (VALUES ({placeholders})) AS src ({src_cols}) "
                f"ON {on_clause} {matched}"
                f"WHEN NOT MATCHED THEN INSERT ({insert_cols}) VALUES ({insert_vals});"
            )

            def _rows(batch):
                return [
                    tuple(_mysql_bind_value(row.get(col), col_types.get(col)) for col in columns)
                    for row in batch
                ]

            rows_upserted = 0
            batch_size = min(self.max_batch_size, 1000)
            for i in range(0, len(data), batch_size):
                batch = data[i:i + batch_size]
                values = _rows(batch)
                try:
                    cursor.executemany(merge_query, values)
                except Exception as e:
                    if "invalid object name" in str(e).lower():
                        try:
                            conn.rollback()
                        except Exception:
                            pass
                        cursor = self._get_cursor(conn, as_dict=False)
                        self._ss_ensure_table_ddl(cursor, config, name, columns, conflict_cols, col_types, params)
                        conn.commit()
                        cursor.executemany(merge_query, values)
                    else:
                        raise
                rows_upserted += len(batch)

            logger.info("upsert_data[sqlserver]: target=%s.%s submitted=%d",
                        schema, name, rows_upserted)
            self._ss_write_cdc_offsets(cursor, params)
            conn.commit()
            cursor.close()
            return {"success": True, "rows_upserted": rows_upserted}
        except Exception as e:
            if conn:
                try:
                    conn.rollback()
                except Exception:
                    pass
            return {"success": False, "error": str(e)}
        finally:
            if conn:
                try:
                    conn.close()
                except Exception:
                    pass

    def _ss_delete_data(self, params: Dict = None) -> Dict[str, Any]:
        """SQL Server CDC delete by key fields."""
        normalized = params or {}
        if isinstance(normalized, dict):
            d = normalized.get("data")
            if d is None:
                for k in ("before", "key", "kafka_key", "record_key", "primary_key", "keys"):
                    if isinstance(normalized.get(k), dict):
                        normalized = {**normalized, "data": [normalized.get(k)]}
                        break
                if normalized.get("data") is None and isinstance(normalized.get("keys"), list):
                    normalized = {**normalized, "data": normalized.get("keys")}
            elif isinstance(d, dict):
                normalized = {**normalized, "data": [d]}

        prepared = self.prepare_import_data(normalized)
        if not prepared.get("success", True):
            return prepared
        config = prepared.get("config") or {}
        table = prepared.get("table")
        data = prepared.get("data", []) or []
        if not table:
            return {"success": False, "error": "Target table not specified"}
        schema, name = self._split_sqlserver_schema_table(config, table, params)
        if not name or not self._is_safe_ident(name):
            return {"success": False, "error": f"Unsafe or missing table identifier: {name}"}
        if schema and not self._is_safe_ident(schema):
            return {"success": False, "error": f"Unsafe schema identifier: {schema}"}
        qname = f"{self._ss_quote(schema)}.{self._ss_quote(name)}"
        if not data:
            return {"success": True, "rows_deleted": 0, "message": "No rows to delete"}

        key_fields = (
            (params.get("key_fields") if isinstance(params, dict) else None)
            or config.get("key_fields") or config.get("primary_key") or config.get("pk_fields")
            or ["id"]
        )
        if isinstance(key_fields, str):
            key_fields = [key_fields]
        if not isinstance(key_fields, list) or not key_fields:
            return {"success": False, "error": "delete_data requires key_fields"}
        key_fields = [k for k in key_fields if self._is_safe_ident(k)]
        if not key_fields:
            return {"success": False, "error": "delete_data: no safe key fields"}

        conn = None
        try:
            conn = self._get_connection(config)
            cursor = self._get_cursor(conn, as_dict=False)
            # CAST both sides to NVARCHAR to tolerate type mismatch (e.g. INT key in a text column).
            where_clause = " AND ".join(
                f"CAST({self._ss_quote(k)} AS NVARCHAR(4000)) = CAST(? AS NVARCHAR(4000))"
                for k in key_fields
            )
            delete_query = f"DELETE FROM {qname} WHERE {where_clause}"
            rows_deleted = 0
            for row in data:
                if not isinstance(row, dict):
                    continue
                missing = [k for k in key_fields if k not in row]
                if missing:
                    return {"success": False, "error": f"delete_data missing key fields in row: {missing}"}
                values = tuple(str(row.get(k)) if row.get(k) is not None else None for k in key_fields)
                cursor.execute(delete_query, values)
                rows_deleted += cursor.rowcount if cursor.rowcount is not None and cursor.rowcount >= 0 else 0
            self._ss_write_cdc_offsets(cursor, params)
            conn.commit()
            cursor.close()
            return {"success": True, "rows_deleted": rows_deleted}
        except Exception as e:
            if conn:
                try:
                    conn.rollback()
                except Exception:
                    pass
            return {"success": False, "error": str(e)}
        finally:
            if conn:
                try:
                    conn.close()
                except Exception:
                    pass

    def get_cdc_offsets(self, params: Dict = None) -> Dict[str, Any]:
        if self._is_sqlserver_dialect():
            return self._ss_get_cdc_offsets(params)
        """Return durable per-partition high-water offsets for a pipeline so the
        sink can seed its skip-map on restart (CDC exactly-once recovery)."""
        params = params or {}
        # Non-DBAPI warehouses (e.g. BigQuery) keep offsets via their adapter.
        if getattr(self, "_warehouse_adapter", None) and hasattr(self._warehouse_adapter, "get_cdc_offsets"):
            config = self._get_config(params) if hasattr(self, "_get_config") else (params.get("config") or {})
            return self._warehouse_adapter.get_cdc_offsets(config, params)  # type: ignore[attr-defined]
        conn = None
        try:
            config = self._get_config(params) if hasattr(self, "_get_config") else ((params or {}).get("config") or {})
            pipeline_id = str((params or {}).get("pipeline_id") or "")
            module = self.driver_pattern.get("module", "") if hasattr(self, "driver_pattern") else ""
            tbl = self._CDC_OFFSETS_TABLE
            conn = self._get_connection(config)
            cursor = self._get_cursor(conn, as_dict=False)
            if "oracledb" in module or "cx_Oracle" in module:
                q = f'SELECT topic, kafka_partition, last_offset FROM "{tbl}" WHERE pipeline_id = :1'
            elif "mysql" in module or "pymysql" in module:
                q = f'SELECT topic, kafka_partition, last_offset FROM `{tbl}` WHERE pipeline_id = %s'
            else:
                q = f'SELECT topic, kafka_partition, last_offset FROM "{tbl}" WHERE pipeline_id = %s'
            try:
                cursor.execute(q, (pipeline_id,))
                rows = cursor.fetchall()
            except Exception:
                # Offset table not provisioned yet => no prior progress.
                try:
                    conn.rollback()
                except Exception:
                    pass
                return {"success": True, "offsets": []}
            finally:
                cursor.close()
            offsets = [{"topic": r[0], "partition": int(r[1]), "offset": int(r[2])} for r in (rows or [])]
            return {"success": True, "offsets": offsets}
        except Exception as e:
            return {"success": False, "error": str(e)}
        finally:
            if conn:
                try:
                    conn.close()
                except Exception:
                    pass

    # NOTE: We intentionally do NOT generate legacy JSON-RPC entrypoint methods like:
    #   def <connector_type>_import_data(...)
    #
    # Reason:
    # - Connector ids are canonical kebab-case (e.g. "quality-test-db"), which are NOT valid Python identifiers.
    # - BaseMCPConnector.handle_request already supports legacy direct-method calls by mapping:
    #     "<connector_type>_<op>"  ->  "<op>"
    #   including hyphenated connector types and underscore fallbacks.
    #
    # This keeps generated connectors valid for ALL ids while preserving backwards compatibility.
    
    def _import_nosql(self, conn, config: Dict, collection: str, data: List) -> Dict:
        """Import into NoSQL database"""
        if "mongo" in self.driver_pattern.get("module", ""):
            database = config.get("database")
            db = conn[database]
            coll = db[collection]
            
            result = coll.insert_many(data)
            return {"success": True, "rows_inserted": len(result.inserted_ids)}
        
        return {"success": False, "error": "Import not supported for this NoSQL database"}
    
    def _upsert_nosql(self, conn, config: Dict, collection: str, data: List, key_fields: List) -> Dict:
        """Upsert into NoSQL database (MongoDB)"""
        if "mongo" in self.driver_pattern.get("module", ""):
            database = config.get("database")
            db = conn[database]
            coll = db[collection]
            
            rows_upserted = 0
            for row in data:
                filter_doc = {k: row.get(k) for k in key_fields if k in row}
                if filter_doc:
                    coll.replace_one(filter_doc, row, upsert=True)
                    rows_upserted += 1
            
            return {"success": True, "rows_upserted": rows_upserted}
        
        return {"success": False, "error": "Upsert not supported for this NoSQL database"}
    
    def _delete_nosql(self, conn, config: Dict, collection: str, data: List, key_fields: List) -> Dict:
        """Delete from NoSQL database (MongoDB)"""
        if "mongo" in self.driver_pattern.get("module", ""):
            database = config.get("database")
            db = conn[database]
            coll = db[collection]
            
            rows_deleted = 0
            for row in data:
                filter_doc = {k: row.get(k) for k in key_fields if k in row}
                if filter_doc:
                    result = coll.delete_one(filter_doc)
                    rows_deleted += result.deleted_count
            
            return {"success": True, "rows_deleted": rows_deleted}
        
        return {"success": False, "error": "Delete not supported for this NoSQL database"}
{% endif %}

