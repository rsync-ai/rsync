    def _coerce_row_count(self, value, default=None):
        """
        Best-effort coercion for item counts from API responses.

        - Returns an int when possible
        - Clamps negative values to 0
        - Returns `default` for missing/unparseable values
        """
        if value is None:
            return default
        try:
            i = int(value)
        except Exception:
            try:
                i = int(float(value))
            except Exception:
                return default
        if i < 0:
            return 0
        return i

    def _extract_total_count(self, body: Any, headers: Dict[str, Any] = None):
        """
        Try to extract a total item count from common API response shapes.

        This is intentionally heuristic and best-effort: many APIs do not expose totals
        without expensive pagination. If we cannot find a clear total, return None.
        """
        # 1) Prefer explicit headers when present (common with REST pagination)
        if headers and isinstance(headers, dict):
            for k in ("x-total-count", "X-Total-Count", "x-total", "X-Total"):
                if k in headers:
                    v = self._coerce_row_count(headers.get(k), default=None)
                    if v is not None:
                        return v

        # 2) JSON bodies with common total fields
        if not isinstance(body, dict):
            return None

        def get_path(d: Dict[str, Any], path: List[str]):
            cur: Any = d
            for p in path:
                if not isinstance(cur, dict) or p not in cur:
                    return None
                cur = cur[p]
            return cur

        candidates: List[List[str]] = [
            # Common top-level totals
            ["total"],
            ["total_count"],
            ["totalCount"],
            ["total_results"],
            ["totalResults"],
            # Common nested totals
            ["meta", "total"],
            ["meta", "total_count"],
            ["meta", "totalCount"],
            ["pagination", "total"],
            ["paging", "total"],
            ["page", "totalElements"],
            ["page", "total_elements"],
            ["result", "total"],
            ["results", "total"],
        ]

        for path in candidates:
            v = get_path(body, path)
            c = self._coerce_row_count(v, default=None)
            if c is not None:
                return c

        return None

    def _extract_first_row(self, body: Any, response_data_key: str = "") -> Optional[Dict[str, Any]]:
        """Find the first record in a list-style REST response.

        REST APIs return list results in wildly different shapes:
          - ``[ {...}, {...} ]``                          (bare array)
          - ``{ "data":    [...] }``                      (Stripe, JSON:API)
          - ``{ "results": [...] }``                      (HubSpot, DRF)
          - ``{ "items":   [...] }``                      (GitHub search)
          - ``{ "value":   [...] }``                      (OData)
          - ``{ "records": [...] }``                      (Salesforce)

        When the vendor spec declares a ``response_data_key`` for this
        resource we honour it first; otherwise we walk the common
        wrapper names. Returns the first item as a dict, or ``None`` if
        we can't find one (used to infer columns when row_count alone
        isn't enough).
        """
        # 1) Bare list response.
        if isinstance(body, list):
            return body[0] if body and isinstance(body[0], dict) else None

        if not isinstance(body, dict):
            return None

        # 2) Honour an explicit response_data_key from the vendor spec.
        if response_data_key:
            cur: Any = body
            for part in response_data_key.split("."):
                if not isinstance(cur, dict) or part not in cur:
                    cur = None
                    break
                cur = cur[part]
            if isinstance(cur, list) and cur and isinstance(cur[0], dict):
                return cur[0]

        # 3) Walk common wrapper names — shared with the runtime paginator via
        # base_connector.RESPONSE_DATA_KEYS so discovery and pagination agree.
        for key in RESPONSE_DATA_KEYS:
            v = body.get(key)
            if isinstance(v, list) and v and isinstance(v[0], dict):
                return v[0]

        return None

    def _infer_columns_from_row(self, row: Optional[Dict[str, Any]]) -> List[Dict[str, str]]:
        """Turn a single record dict into a canonical column list.

        REST has no introspection, so we infer columns from the first
        row of a ``GET ?limit=1`` probe. Each column is emitted with a
        canonical type name (see
        shared/mcp-connectors/schemas/response_schemas.py) so sinks can
        translate to their dialect without per-source knowledge:

          - dict / list values  -> ``"json"`` (stored as JSONB / JSON)
          - bool                -> ``"boolean"``
          - int                 -> ``"integer"``
          - float               -> ``"number"``
          - str                 -> ``"string"``
          - None                -> ``"string"`` (best fallback; the
                                   sink's canonical layer also coerces
                                   "unknown" -> "string")

        ISO-8601 timestamp detection is intentionally NOT done here —
        REST APIs vary too much. Sinks coerce timestamp strings at
        bind time when the column type is declared.

        Returns ``[]`` when row is None, empty, or not a dict.
        """
        if not isinstance(row, dict) or not row:
            return []

        def canonical(v: Any) -> str:
            if v is None:
                return "string"
            if isinstance(v, bool):
                return "boolean"
            if isinstance(v, int):
                return "integer"
            if isinstance(v, float):
                return "number"
            if isinstance(v, str):
                return "string"
            if isinstance(v, (list, dict)):
                return "json"
            return "string"

        return [{"name": str(k), "type": canonical(v)} for k, v in row.items()]

