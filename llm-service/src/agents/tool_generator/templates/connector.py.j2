    def list_objects(
        self,
        *,
        config: Dict,
        bucket: str,
        prefix: str = "",
        max_keys: int = 1000,
    ) -> List[Dict[str, Any]]:
        """List objects under bucket/prefix (required by StorageHandler)."""
        s3 = self._get_s3_client(config)

        out: List[Dict[str, Any]] = []
        token: Optional[str] = None

        # list_objects_v2 pagination
        while len(out) < max_keys:
            req = {
                "Bucket": bucket,
                "Prefix": prefix or "",
                "MaxKeys": min(1000, max_keys - len(out)),
            }
            if token:
                req["ContinuationToken"] = token

            resp = s3.list_objects_v2(**req)
            for item in (resp.get("Contents") or []):
                lm = item.get("LastModified")
                out.append(
                    {
                        "key": item.get("Key"),
                        "size": item.get("Size"),
                        "last_modified": lm.isoformat() if hasattr(lm, "isoformat") else str(lm),
                    }
                )
                if len(out) >= max_keys:
                    break

            if not resp.get("IsTruncated"):
                break
            token = resp.get("NextContinuationToken")
            if not token:
                break

        return out

    def download_file(
        self,
        *,
        config: Dict,
        bucket: str,
        key: str,
    ) -> bytes:
        """Download object bytes (required by StorageHandler)."""
        s3 = self._get_s3_client(config)
        resp = s3.get_object(Bucket=bucket, Key=key)
        body = resp.get("Body")
        if body is None:
            return b""
        return body.read()
