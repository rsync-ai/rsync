                    if _val is None or _val == "":
                        raise ValueError(
                            f"Missing required path parameter '{_key}' for endpoint '{endpoint}'"
                        )
                    return str(_val)
                endpoint = _re_pp.sub(r"\{([^/{}]+)\}", _sub_path_param, endpoint)
                if _consumed and isinstance(params, dict):
                    params = {k: v for k, v in params.items() if k not in _consumed}
            url = f"{str(base).rstrip('/')}/{endpoint.lstrip('/')}"

        headers = self._get_headers(config)
{% if spec.auth.supported_methods %}
        # api_key_query (multi-auth): the chosen method may carry its credential
        # in the URL query string instead of a header (_get_headers skipped it).
        # Inject it here so BOTH _make_request and the data path authenticate.
        _auth_spec = self.SUPPORTED_AUTH_METHODS.get(self._resolve_auth_method(config), {})
        _qp = _auth_spec.get("query_param")
        if _qp:
            _tok = ""
            for _k in _auth_spec.get("config_keys", []):
                _v = (config or {}).get(_k)
                if _v:
                    _tok = _v
                    break
            if not _tok and os.getenv("ALLOW_ENV_CREDENTIALS", "true").lower() != "false":
                _tok = os.getenv('{{ spec.auth.env_var or "MCP_API_KEY" }}', '')
            if _tok:
                params = {**(params or {}), _qp: _tok}
{% elif spec.auth.type.value == 'api_key_query' %}
        # api_key_query (single-auth): credential rides in the URL query string.
        _tok = (config or {}).get('api_key') or (config or {}).get('token')
        if not _tok and os.getenv("ALLOW_ENV_CREDENTIALS", "true").lower() != "false":
            _tok = os.getenv('{{ spec.auth.env_var or "MCP_API_KEY" }}', '')
        if _tok:
            params = {**(params or {}), {{ spec.auth.query_param | tojson }}: _tok}
{% endif %}
{% if spec.default_headers %}
        # Spec-declared constant headers required by the API on every call
        # (e.g. an API-version pin). setdefault so auth/Content-Type/Accept from
        # _get_headers() always win on a key collision.
        for _hk, _hv in {{ spec.default_headers | tojson }}.items():
            headers.setdefault(_hk, _hv)
{% endif %}
{% if spec.header_config_keys %}
        # Required headers the spec declares without a fixed value (e.g.
        # Notion-Version) — sent from connection config when the user supplied
        # them. setdefault so an explicit auth/standard header still wins.
        for _hck in {{ spec.header_config_keys | tojson }}:
            _hcv = (config or {}).get(_hck)
            if _hcv:
                headers.setdefault(_hck, str(_hcv))
{% endif %}
{% if spec.auth.extra_required_headers %}
        # Stamp each co-required credential header from connection config so ALL
        # of them ride every request (single-header auth would 403 on these APIs).
        for _erh in self.EXTRA_REQUIRED_HEADERS:
            _erh_tok = ""
            for _erh_k in _erh.get("config_keys", []):
                _erh_v = (config or {}).get(_erh_k)
                if _erh_v:
                    _erh_tok = _erh_v
                    break
            if _erh.get("header_name") and _erh_tok:
                _erh_prefix = (_erh.get("header_prefix") or "").strip()
                headers[_erh["header_name"]] = (
                    f"{_erh_prefix} {_erh_tok}".strip() if _erh_prefix else str(_erh_tok)
                )
{% endif %}
        return super()._make_request_v2(
            method=method,
            url=url,
            headers=headers,
            params=params,
            json_data=data,
            # Send POST/PUT/PATCH bodies as x-www-form-urlencoded for APIs that
            # require it and ignore JSON (Twilio classic, Stripe). Connector-level
            # flag from the OpenAPI requestBody media types; defaults to JSON.
            form_encoded={{ 'True' if spec.write_content_type == 'form' else 'False' }},
            timeout={{ spec.connection_timeout }},
        )

