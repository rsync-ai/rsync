            method=method,
            endpoint=endpoint,
            config=config,
            params=params,
            data=data,
        )
        if not success:
            return {
                "success": False,
                "status_code": status_code,
                "data": body,
                "headers": resp_headers,
                "error": f"HTTP {status_code}",
            }
        return {
            "success": True,
            "status_code": status_code,
            "data": body,
            "headers": resp_headers,
        }

