      "description": "95th-percentile request latency.",
      "panelTypes": "graph",
      "yAxisUnit": "s",
      "nullZeroValues": "zero",
      "query": {
        "queryType": "promql",
        "promql": [
          { "name": "A", "query": "histogram_quantile(0.95, sum by (le, route) (rate(rsync_gateway_http_request_duration_seconds_bucket[5m])))", "legend": "{{route}}", "disabled": false }
        ],
        "builder": { "queryData": [], "queryFormulas": [] },
        "clickhouse_sql": []
      },
      "timePreferance": "GLOBAL"
    },
