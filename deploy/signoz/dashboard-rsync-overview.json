{
  "title": "rsync-ai — Pipeline & Gateway Overview",
  "description": "Domain SLIs for rsync-ai: gateway request/latency/auth, pipeline success & duration, MCP connector health, Kafka/DLQ throughput, and healer activity. Source metrics are scraped by the otel-collector prometheus receiver from api-gateway:8080/metrics and orchestrator:8080/metrics, then forwarded to SigNoz. Import via SigNoz UI → Dashboards → Import JSON. F-Obs-2.",
  "tags": ["rsync-ai", "observability", "F-Obs-2"],
  "layout": [
    { "i": "gw-req-rate", "x": 0, "y": 0, "w": 6, "h": 3 },
    { "i": "gw-5xx-rate", "x": 6, "y": 0, "w": 6, "h": 3 },
    { "i": "gw-latency-p95", "x": 0, "y": 3, "w": 6, "h": 3 },
    { "i": "gw-auth-failures", "x": 6, "y": 3, "w": 6, "h": 3 },
    { "i": "gw-run-triggers", "x": 0, "y": 6, "w": 6, "h": 3 },
    { "i": "pipe-runs", "x": 6, "y": 6, "w": 6, "h": 3 },
    { "i": "pipe-duration-p95", "x": 0, "y": 9, "w": 6, "h": 3 },
    { "i": "mcp-failure-rate", "x": 6, "y": 9, "w": 6, "h": 3 },
    { "i": "kafka-published", "x": 0, "y": 12, "w": 6, "h": 3 },
    { "i": "dlq-rate", "x": 6, "y": 12, "w": 6, "h": 3 },
    { "i": "healer-actions", "x": 0, "y": 15, "w": 12, "h": 3 }
  ],
  "widgets": [
    {
      "id": "gw-req-rate",
      "title": "Gateway request rate by status",
      "description": "req/s per HTTP status class.",
      "panelTypes": "graph",
      "yAxisUnit": "reqps",
      "nullZeroValues": "zero",
      "query": {
        "queryType": "promql",
        "promql": [
          { "name": "A", "query": "sum by (status) (rate(rsync_gateway_http_requests_total[5m]))", "legend": "{{status}}", "disabled": false }
        ],
        "builder": { "queryData": [], "queryFormulas": [] },
        "clickhouse_sql": []
      },
      "timePreferance": "GLOBAL"
    },
    {
      "id": "gw-5xx-rate",
      "title": "Gateway 5xx error rate",
      "description": "Server-error responses per second.",
      "panelTypes": "graph",
      "yAxisUnit": "reqps",
      "nullZeroValues": "zero",
      "query": {
        "queryType": "promql",
        "promql": [
          { "name": "A", "query": "sum by (route) (rate(rsync_gateway_http_requests_total{status=~\"5..\"}[5m]))", "legend": "{{route}}", "disabled": false }
        ],
        "builder": { "queryData": [], "queryFormulas": [] },
        "clickhouse_sql": []
      },
      "timePreferance": "GLOBAL"
    },
    {
      "id": "gw-latency-p95",
