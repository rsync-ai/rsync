# Frontend Environment Variables - Example Configuration

# Public URLs - Used by browser (client-side)
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_BACKEND_ORCHESTRATOR_URL=http://localhost:8081
NEXT_PUBLIC_LLM_SERVICE_URL=http://localhost:5011

# WebSocket URLs
NEXT_PUBLIC_WS_URL=ws://localhost:5001/ws
NEXT_PUBLIC_WS_ORCHESTRATOR_URL=ws://localhost:8081/ws

# App Configuration
NEXT_PUBLIC_APP_NAME=Rsync AI
NEXT_PUBLIC_ENVIRONMENT=development

# Internal URLs (server-side)
# HOST: use localhost | DOCKER: use service names (api-gateway, orchestrator)
API_GATEWAY_INTERNAL_URL=http://localhost:5001
ORCHESTRATOR_INTERNAL_URL=http://localhost:8081

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-in-production
