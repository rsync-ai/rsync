# Frontend Environment Variables — Production
#
# Usage:
#   cp frontend/.env.prod.example frontend/.env
#   # Edit frontend/.env and replace YOUR_SERVER_IP / YOUR_DOMAIN
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build frontend
#
# IMPORTANT: NEXT_PUBLIC_* vars are baked into the Next.js bundle at BUILD TIME.
# After changing any NEXT_PUBLIC_* value you MUST rebuild the frontend image:
#   docker compose ... up -d --build frontend
#
# ─── Traefik routing ──────────────────────────────────────────────────────────
# In production, ALL traffic goes through Traefik (port 80 / 443).
# Do NOT use explicit ports like :5001, :8081, :3000 — those ports are not
# exposed on the host. Traefik routes /api/* → api-gateway, /ws/* → ws,
# everything else → frontend.
#
# IP-only (no domain, no TLS — testing):
#   DOMAIN=YOUR_SERVER_IP (e.g. 203.0.113.10)
#   All URLs use http:// and NO port suffix
#
# With domain + HTTPS (production):
#   DOMAIN=your-domain.com
#   All URLs use https://
# ─────────────────────────────────────────────────────────────────────────────

# ---------------------------------------------------------------------------
# Public URLs — used by the BROWSER (client-side JavaScript)
# All traffic goes through Traefik on port 80 (HTTP) or 443 (HTTPS).
# NO port suffixes — Traefik is the only public entrypoint.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP
NEXT_PUBLIC_BACKEND_ORCHESTRATOR_URL=http://YOUR_SERVER_IP
NEXT_PUBLIC_LLM_SERVICE_URL=http://YOUR_SERVER_IP
NEXT_PUBLIC_WS_URL=ws://YOUR_SERVER_IP/ws
NEXT_PUBLIC_WS_ORCHESTRATOR_URL=ws://YOUR_SERVER_IP/ws

# ---------------------------------------------------------------------------
# App configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Rsync AI
NEXT_PUBLIC_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Internal URLs — used by Next.js SERVER-SIDE (SSR / API routes)
# Uses Docker service names and INTERNAL container ports, not public IP/ports.
# api-gateway listens on :8080 internally (mapped to :5001 in dev only)
# orchestrator listens on :8080 internally (mapped to :8081 in dev only)
# ---------------------------------------------------------------------------
API_GATEWAY_INTERNAL_URL=http://api-gateway:8080
ORCHESTRATOR_INTERNAL_URL=http://orchestrator:8080

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Must match the public URL exactly (no trailing slash, no port).
NEXTAUTH_URL=http://YOUR_SERVER_IP

# Generate a real secret — run this and paste the output:
#   openssl rand -base64 32
# NEVER use the literal string $(openssl rand -base64 32) — it is not evaluated.
NEXTAUTH_SECRET=CHANGE_ME_run_openssl_rand_base64_32
